{
  "interactiveLogin": true,
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "code",
          "match": ".*",
          "claims": {
            "sub": "user",
            "email": "user@example.com",
            "aud": ["debugger"],
            "scope": "openid somescope",
            "nonce": "5678",
            "amr": ["mfa", "pwd"]
          }
        }
      ]
    },
    {
      "issuerId": "oauth2",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "diya-submit-mcp-proxy",
          "claims": {
            "sub": "mcp-proxy-user",
            "email": "mcp-proxy-user@example.com",
            "client_id": "diya-submit-mcp-proxy",
            "aud": ["diya-submit-mcp-proxy"],
            "scope": "email openid profile",
            "amr": ["mfa", "pwd"]
          }
        }
      ]
    },
    {
      "issuerId": "mcp",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "client_id",
          "match": "mcp-local",
          "claims": {
            "sub": "mcp-local-user",
            "email": "mcp-local-user@example.com",
            "token_use": "access",
            "client_id": "mcp-local",
            "scope": "openid email profile"
          }
        }
      ]
    }
  ]
}
