# .env.proxy
#
# Features:
#   Local server terminating TLS on a real certificate at local.submit.diyaccounting.co.uk.
#   HMRC Test API.
#   DynamoDB (like) storage.
#   Mock OAuth2 server.
DIY_SUBMIT_ENV_FILEPATH=.env.proxy
DOTENV_CONFIG_QUIET=true
ENVIRONMENT_NAME=proxy
DEPLOYMENT_NAME=proxy
DIY_SUBMIT_BASE_URL=https://local.submit.diyaccounting.co.uk:3443/
GA4_MEASUREMENT_ID=

LOG_TO_CONSOLE=true
LOG_TO_FILE=true
CLOUD_TRAIL_ENABLED=

HMRC_BASE_URI=https://test-api.service.hmrc.gov.uk
HMRC_ACCOUNT=synthetic
# NOTE: HMRC_CLIENT_ID below is a test application credential for HMRC Sandbox API - not a production secret
HMRC_CLIENT_ID=uqMHA6RsDGGa7h8EG2VqfqAmv4tV
HMRC_SANDBOX_BASE_URI=https://test-api.service.hmrc.gov.uk
# NOTE: HMRC_SANDBOX_CLIENT_ID is a test application credential for HMRC Sandbox API - not a production secret
HMRC_SANDBOX_CLIENT_ID=uqMHA6RsDGGa7h8EG2VqfqAmv4tV
