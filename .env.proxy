# .env.proxy
#
# Features:
#   Local server terminating TLS on a real certificate at local.submit.diyaccounting.co.uk.
#   HMRC Test API.
#   DynamoDB (like) storage.
#   Mock OAuth2 server.
DIY_SUBMIT_ENV_FILEPATH=.env.proxy
DOTENV_CONFIG_QUIET=true
ENVIRONMENT_NAME=proxy
DEPLOYMENT_NAME=proxy
DIY_SUBMIT_BASE_URL=https://local.submit.diyaccounting.co.uk:3443/

LOG_TO_CONSOLE=true
LOG_TO_FILE=true
CLOUD_TRAIL_ENABLED=

HMRC_BASE_URI=https://test-api.service.hmrc.gov.uk
HMRC_ACCOUNT=sandbox
# NOTE: HMRC_CLIENT_ID below is a test application credential for HMRC Sandbox API - not a production secret
HMRC_CLIENT_ID=uqMHA6RsDGGa7h8EG2VqfqAmv4tV
HMRC_SANDBOX_BASE_URI=https://test-api.service.hmrc.gov.uk
# NOTE: HMRC_SANDBOX_CLIENT_ID is a test application credential for HMRC Sandbox API - not a production secret
HMRC_SANDBOX_CLIENT_ID=uqMHA6RsDGGa7h8EG2VqfqAmv4tV
GOOGLE_CLIENT_SECRET_ARN=
HMRC_CLIENT_SECRET_ARN=
HMRC_SANDBOX_CLIENT_SECRET_ARN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_BASE_URI=
USER_SUB_HASH_SALT={"current":"v1","versions":{"v1":"local-development-salt-not-for-production"}}
BUNDLE_DYNAMODB_TABLE_NAME=test-bundle-table
RECEIPTS_DYNAMODB_TABLE_NAME=test-receipts-table
HMRC_API_REQUESTS_DYNAMODB_TABLE_NAME=test-hmrc-api-requests-table
PASSES_DYNAMODB_TABLE_NAME=test-passes-table
BUNDLE_CAPACITY_DYNAMODB_TABLE_NAME=test-bundle-capacity-table
EMAIL_HASH_SECRET=local-development-email-hash-secret-not-for-production
HMRC_VAT_RETURN_POST_ASYNC_REQUESTS_TABLE_NAME=test-hmrc-vat-return-post-async-requests-table
HMRC_VAT_RETURN_GET_ASYNC_REQUESTS_TABLE_NAME=test-hmrc-vat-return-get-async-requests-table
HMRC_VAT_OBLIGATION_GET_ASYNC_REQUESTS_TABLE_NAME=test-hmrc-vat-obligation-get-async-requests-table
HMRC_VAT_LIABILITIES_GET_ASYNC_REQUESTS_TABLE_NAME=test-hmrc-vat-liabilities-get-async-requests-table
SQS_QUEUE_URL=none
# Local DynamoDB endpoint - set by behaviour tests dynamically via AWS_ENDPOINT_URL_DYNAMODB env var
# This value is a fallback; tests set the real ephemeral port value
AWS_ENDPOINT_URL_DYNAMODB=
ACCESS_LOG_GROUP_RETENTION_PERIOD_DAYS=
S3_RETAIN_RECEIPTS_BUCKET=

TEST_SERVER_HTTP_PORT=3000
TEST_SERVER_HTTP=run
TEST_SERVER_TLS=run
TEST_SERVER_HTTPS_PORT=3443
TEST_MOCK_OAUTH2=run
TEST_AUTH_PROVIDER=mock
TEST_AUTH_USERNAME=user
TEST_AUTH_PASSWORD=
TEST_DYNAMODB=run

TEST_MFA_ENABLED=true
TEST_MFA_TYPE=TOTP
TEST_MFA_TIMESTAMP=2026-01-08T00:09:01Z

TEST_BUNDLE_EXPIRY_DATE=2025-12-31
TEST_BUNDLE_USER_LIMIT=1000
TEST_BUNDLE_MOCK=true
TEST_VAT_OBLIGATIONS={}
TEST_VAT_LIABILITY={}
TEST_VAT_RETURN={}

STRIPE_PRICE_ID_RESIDENT_PRO=price_1SzkPBCD0Ld2ukzIqbEweRSk
STRIPE_TEST_PRICE_ID_RESIDENT_PRO=price_1Szjt0FdFHdRoTOjHDXcuuq8
STRIPE_PRICE_ID_RESIDENT_VAT=price_1TEgZUFdFHdRoTOjBUo4A3XC
STRIPE_TEST_PRICE_ID_RESIDENT_VAT=price_1TEgZUFdFHdRoTOjBUo4A3XC
TELEGRAM_TEST_CHAT_ID=
TELEGRAM_LIVE_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=
