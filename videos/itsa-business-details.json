{
  "$schema": "./scene-script.schema.json",
  "name": "itsa-business-details",
  "title": "See the businesses HMRC has on file for your Self Assessment",
  "description": "A signed-in walk through ITSA Business Details: sign in, take out Resident ITSA, ask HMRC which self-employment and property businesses it holds against your National Insurance number, and read the answer.",
  "auth": "user",
  "hmrcServices": ["mtd-vat", "mtd-income-tax"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 1,
  "fps": 60,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "HMRC keeps a list of the businesses behind your Self Assessment."
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use."
        },
        {
          "action": "login",
          "caption": "Your account keeps your filings in one place."
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident ITSA",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run."
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident ITSA",
          "testPass": true,
          "caption": "Resident ITSA opens the Self Assessment activities."
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page."
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "business-details-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "Self Assessment (HMRC)" },
          "expectsNavigation": true,
          "caption": "Open Self Assessment to ask HMRC about your businesses."
        },
        { "action": "await", "until": "#itsaBusinessDetailsForm", "label": "Opening the business details form" },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "Type the National Insurance number HMRC asks for."
        },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access."
        },
        {
          "action": "hmrcAuthorise",
          "caption": "Sign in to HMRC and say yes once.",
          "timeoutMs": 60000
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "results",
      "chapter": "The answer",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#businessDetailsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers with the businesses it holds against that number."
        },
        { "action": "scroll", "target": "#businessDetailsTable" },
        { "action": "hold", "ms": 1500 },
        {
          "action": "point",
          "target": "#businessDetailsTable",
          "caption": "Each row carries a business ID. Every later Self Assessment filing needs it.",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "business-details-table" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
