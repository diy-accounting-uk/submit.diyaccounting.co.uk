{
  "$schema": "./scene-script.schema.json",
  "name": "itsa-business-details",
  "title": "See the businesses HMRC has on file for your Self Assessment",
  "description": "A signed-in walk through ITSA Business Details: sign in, take out Resident, ask HMRC which self-employment and property businesses it holds against your National Insurance number, and read the answer.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/hmrc/itsa/dashboard.html",
    "web/public/hmrc/itsa/businessDetails.html"
  ],
  "hmrcServices": ["mtd-vat", "mtd-income-tax"],
  "environments": ["ci"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#syntheticIndicator", "#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ],
      "offCamera": true
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "steps": [
        {
          "action": "click",
          "target": "a.login-link"
        },
        {
          "action": "login"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ],
      "offCamera": true
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          }
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          }
        },
        {
          "action": "await",
          "until": "button:has-text('Self Assessment (HMRC, sandbox)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ],
      "offCamera": true
    },
    {
      "id": "business-details-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "HMRC keeps a list of the businesses behind your Self Assessment.",
          "holdMs": 1200,
          "headline": "See your businesses",
          "keyWord": "businesses"
        },
        {
          "action": "caption",
          "text": "You are already signed in. See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Already signed in",
          "keyWord": "signed"
        },
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "Self Assessment (HMRC, sandbox)"
          },
          "expectsNavigation": true,
          "caption": "Making Tax Digital for Income Tax starts from one dashboard.",
          "headline": "One dashboard for MTD",
          "keyWord": "dashboard"
        },
        {
          "action": "await",
          "until": "#businessPickerForm",
          "label": "Opening the ITSA dashboard"
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Go to Business Details"
          },
          "caption": "Business Details is the first step: which businesses does HMRC know about?",
          "headline": "Start with Business Details",
          "keyWord": "Business"
        },
        {
          "action": "await",
          "until": "#itsaBusinessDetailsForm",
          "label": "Opening the business details form"
        },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "Type the National Insurance number HMRC asks for.",
          "headline": "Enter your NI number",
          "keyWord": "NI"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access.",
          "headline": "Ask HMRC for access",
          "keyWord": "access"
        }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "offCamera": true,
      "steps": [
        {
          "action": "hmrcAuthorise",
          "timeoutMs": 60000
        }
      ]
    },
    {
      "id": "results",
      "chapter": "The answer",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "HMRC access was granted off screen. See it in full in our HMRC authorisation video.",
          "holdMs": 1200,
          "headline": "Access granted, faster",
          "keyWord": "faster"
        },
        {
          "action": "await",
          "until": "#businessDetailsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers with the businesses it holds against that number.",
          "headline": "HMRC lists your businesses",
          "keyWord": "businesses"
        },
        {
          "action": "scroll",
          "target": "#businessDetailsTable"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "point",
          "target": "#businessDetailsTable",
          "caption": "Each row carries a business ID. Every later Self Assessment filing needs it.",
          "headline": "Note each business ID",
          "keyWord": "ID",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "still",
          "name": "business-details-table"
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    }
  ]
}
