{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://submit.diyaccounting.co.uk/videos/scene-script.schema.json",
  "title": "site-video-capture scene script",
  "description": "One JSON file per video under videos/. See PLAN section 3 in the site-video-capture design for the full write-up. Enforced at load time by scripts/lib/video/scriptSchema.js, since this file is documentation and a $schema pointer, not itself the runtime validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "title", "description", "auth", "pages", "viewport", "fps", "pacing", "captions", "scenes"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "auth": {
      "type": "string",
      "enum": ["none", "user"],
      "description": "\"user\" says the journey needs a signed-in account, and unlocks the login, consent, ensureBundle and hmrcAuthorise actions. Which identity provider signs the account in comes from TEST_AUTH_PROVIDER at run time, never from the script, so one script proves locally against the simulator variant and records against a deployment through the Cognito Hosted UI."
    },
    "pages": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Every web/public/ page this script's scenes visit, as repo-relative paths. Lets a change to those pages (or a shared asset under web/public/) find the scripts that need re-recording without running any of them."
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 },
    "fps": { "type": "integer", "minimum": 1 },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perCharMs",
        "betweenActionsMs",
        "aroundMotionMs",
        "minResidualMs",
        "timerThresholdMs",
        "timerFullScaleMs",
        "waitCompressionAfterMs",
        "waitCompressionFactor"
      ],
      "properties": {
        "perCharMs": { "type": "number", "minimum": 0 },
        "betweenActionsMs": { "type": "number", "minimum": 0 },
        "aroundMotionMs": { "type": "number", "minimum": 0 },
        "minResidualMs": { "type": "number", "minimum": 0 },
        "timerThresholdMs": { "type": "number", "minimum": 0 },
        "timerFullScaleMs": { "type": "number", "exclusiveMinimum": 0 },
        "waitCompressionAfterMs": { "type": "number", "minimum": 0 },
        "waitCompressionFactor": { "type": "number", "exclusiveMinimum": 1 }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontPx", "lineHeightPx", "maxLines", "maxCharsPerLine", "charsPerSecond", "minMs", "fadeMs", "safeArea"],
      "properties": {
        "fontPx": { "type": "number", "exclusiveMinimum": 0 },
        "lineHeightPx": { "type": "number", "exclusiveMinimum": 0 },
        "maxLines": { "type": "integer", "minimum": 1 },
        "maxCharsPerLine": { "type": "integer", "minimum": 1 },
        "charsPerSecond": { "type": "number", "exclusiveMinimum": 0 },
        "minMs": { "type": "number", "minimum": 0 },
        "fadeMs": { "type": "number", "minimum": 0 },
        "safeArea": {
          "type": "object",
          "additionalProperties": false,
          "required": ["topPct", "bottomPct", "sidePct"],
          "properties": {
            "topPct": { "type": "number", "minimum": 0, "maximum": 50 },
            "bottomPct": { "type": "number", "minimum": 0, "maximum": 50 },
            "sidePct": { "type": "number", "minimum": 0, "maximum": 50 }
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": { "type": "string", "enum": ["ci", "prod"] },
      "minItems": 1,
      "default": ["ci", "prod"],
      "description": "Where this script can be recorded. Defaults to [\"ci\", \"prod\"] when absent. An activity absent from prod records against a ci set instead: declare [\"ci\"] so the on-deploy dispatcher, which only ever targets prod, leaves this script out."
    },
    "localApp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "url", "readyPattern"],
      "description": "Starts a local app this recording needs, that is not the submit site itself (an MCP Inspector session over a stdio server, say). `command` is run as its own process group; `url` becomes the recording's base url once `readyPattern` matches the command's own stdout/stderr, or the run fails after `readyTimeoutMs` (default 30000). `--base-url` is optional when a script declares this and stays a plain override when given. The app is stopped when the run ends, on success or failure.",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "readyPattern": { "type": "string", "minLength": 1 },
        "readyTimeoutMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "suppress": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "finalHoldMs": { "type": "number", "minimum": 0 },
    "hmrcServices": {
      "type": "array",
      "items": { "type": "string", "enum": ["mtd-vat", "mtd-income-tax"] },
      "minItems": 1,
      "default": ["mtd-vat"],
      "description": "HMRC sandbox services the run's minted test user needs, passed to the Create Test User API. Defaults to [\"mtd-vat\"]. A script whose journey needs the user's National Insurance number (the {{hmrcNino}} placeholder) declares [\"mtd-vat\", \"mtd-income-tax\"]. Ignored when TEST_HMRC_USERNAME supplies a real test user instead of minting one."
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/scene" }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "chapter", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
        "chapter": { "type": "string", "minLength": 1 },
        "still": { "type": "boolean" },
        "offCamera": {
          "type": "boolean",
          "description": "Runs the scene's steps with zero pacing, no captions, no chapter label and no stills, and pauses frame capture for its duration, so nothing from it reaches the encoded video, the vtt or the transcript. Its steps still land in the timeline (each carrying offCamera: true) so the acceptance checks can see them, but the timing checks skip timer and residual expectations for them. For a real step the video does not need to show, such as submitting a return before viewing it."
        },
        "fastForward": {
          "type": "boolean",
          "description": "Runs the scene's steps with zero pacing, the same treatment a CLI --scene run gives an unselected scene, but stays on camera: frames keep capturing, and the chapter label and any caption or headline still show, each held for only its minimum. No still is taken, same as a CLI-selected fast-forward. For a preamble every video repeats, such as signing in and taking a day pass, so the viewer sees it happen, faster, rather than sitting through it at full pace again."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/step" }
        }
      }
    },
    "target": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "name"],
          "properties": { "role": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": { "text": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["action"],
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "goto" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "url"],
            "properties": {
              "action": {},
              "url": { "type": "string", "minLength": 1 },
              "waitFor": { "type": "string" },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" },
              "delayRoutePattern": {
                "type": "string",
                "minLength": 1,
                "description": "Playwright route glob to intercept and delay before navigating. For rehearsing the timer overlay and wait-compression against a local instance with no slow backend of its own — not for the tour scripts."
              },
              "delayRouteMs": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "click" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "target"],
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "expectsNavigation": {
                "type": "boolean",
                "description": "Set when the click's own handler navigates via window.location.href rather than a real <a href> — races the click against the URL changing so a dropped or delayed navigation fails here, named, instead of a later await step timing out with no clue why."
              },
              "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "point" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "target"],
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "dwellMs": { "type": "number", "minimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "type" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "target", "text"],
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "text": { "$ref": "#/definitions/substitutedText" },
              "clear": { "type": "boolean" },
              "secret": { "$ref": "#/definitions/secret" },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "fill" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "target", "value"],
            "description": "Sets a field's value in one go, with the pointer move and highlight a type step gives but no per-character typing. For a date picker, where typing digit by digit lands them in the browser's own segment order and produces a different date.",
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "value": { "$ref": "#/definitions/substitutedText" },
              "holdMs": { "type": "number", "minimum": 0 },
              "secret": { "$ref": "#/definitions/secret" },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "press" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "key"],
            "properties": {
              "action": {},
              "key": { "type": "string", "minLength": 1 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "tab" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": {},
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "select" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "target", "value"],
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "value": { "type": "string" },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "scroll" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "to": { "enum": ["top", "bottom"] },
              "durationMs": { "type": "number", "minimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "highlight" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "target"],
            "properties": {
              "action": {},
              "target": { "$ref": "#/definitions/target" },
              "holdMs": { "type": "number", "minimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "sheetPrepare" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action"],
            "description": "Waits for the Collabora workbook to open, then clears its welcome panel, recalculates every formula and turns spelling underlines off. Off camera, once per load.",
            "properties": {
              "action": {},
              "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "sheetZoom" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "percent"],
            "description": "Sets the sheet zoom.",
            "properties": {
              "action": {},
              "percent": { "type": "integer", "description": "One of Collabora's zoom steps: 20, 25, 30, 35, 40, 50, 60, 70, 85, 100, 120, 150, 170, 200, 235, 280, 335, 400." },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "sheetCell" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "cell"],
            "description": "Moves the cell cursor to a cell and points the on-screen pointer at it.",
            "properties": {
              "action": {},
              "cell": { "type": "string", "minLength": 1, "description": "Sheet and cell, like SalesApr!A4 or Profit & Loss Acc!C24." },
              "dwellMs": { "type": "number", "minimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "sheetPoint" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "cell"],
            "description": "Like sheetCell, with a default dwell, for pointing at a total.",
            "properties": {
              "action": {},
              "cell": { "type": "string", "minLength": 1, "description": "Sheet and cell, like SalesApr!F1." },
              "dwellMs": { "type": "number", "minimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "sheetType" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "text"],
            "description": "Types into the current cell, then presses Tab or Enter.",
            "properties": {
              "action": {},
              "text": { "$ref": "#/definitions/substitutedText", "description": "Typed into the cell the cursor is on, through Collabora's socket messages. Empty text presses the key alone." },
              "then": { "type": "string", "enum": ["Tab", "Enter"] },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "caption" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "text"],
            "properties": {
              "action": {},
              "text": { "type": "string", "minLength": 1 },
              "holdMs": { "type": "number", "minimum": 0 },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "hold" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "ms"],
            "properties": {
              "action": {},
              "ms": { "type": "number", "minimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "await" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "until"],
            "properties": {
              "action": {},
              "until": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "still" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "name"],
            "properties": {
              "action": {},
              "name": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "login" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action"],
            "description": "Signs the account in from the site's sign-in options page and waits for the logged-in home page. The provider, username and password come from TEST_AUTH_PROVIDER, TEST_AUTH_USERNAME, TEST_AUTH_PASSWORD and TEST_AUTH_TOTP_SECRET, so no credential ever appears in a scene script. Needs auth \"user\".",
            "properties": {
              "action": {},
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "consent" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action"],
            "description": "Accepts the analytics consent prompt when the environment shows one, and passes on when it does not. Needs auth \"user\".",
            "properties": {
              "action": {},
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "ensureBundle" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "bundle"],
            "description": "Makes sure the signed-in account holds a bundle, granting it if it does not. Run it while the browser is on the bundles page. Needs auth \"user\".",
            "properties": {
              "action": {},
              "bundle": { "type": "string", "minLength": 1 },
              "testPass": { "type": "boolean", "description": "Grant through a test pass, which carries the HMRC sandbox qualifier." },
              "hidden": {
                "type": "boolean",
                "description": "The bundle is not in the catalogue and only ever appears under the account's current bundles."
              },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "testScenario" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action", "value"],
            "description": "Sets the page's hidden Gov-Test-Scenario select (#testScenario unless target says otherwise) without opening the developer panel, so HMRC's sandbox answers with sample data instead of \"no data found\". Fails when the page has no such select or option. Place it before the step that submits the form. Needs auth \"user\".",
            "properties": {
              "action": {},
              "value": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "hmrcAuthorise" } } },
          "then": {
            "additionalProperties": false,
            "required": ["action"],
            "description": "Walks HMRC's own authorise pages: cookies, continue, sign in with the test user, grant authority, back to the site. Place it directly after the step that triggers the redirect. The HMRC test user comes from TEST_HMRC_USERNAME, TEST_HMRC_PASSWORD and TEST_HMRC_VAT_NUMBER, or is minted for the run when HMRC_ACCOUNT is sandbox. Only the first HMRC call of a journey redirects, so a script makes at most one of these. Needs auth \"user\".",
            "properties": {
              "action": {},
              "timeoutMs": { "type": "number", "exclusiveMinimum": 0 },
              "caption": { "type": "string" },
              "headline": { "type": "string", "minLength": 1 },
              "keyWord": { "type": "string", "minLength": 1 },
              "pauseMs": { "type": "number", "minimum": 0 },
              "note": { "type": "string" },
              "fastForward": {
                "type": "boolean",
