{
  "$schema": "./scene-script.schema.json",
  "name": "subscription-management",
  "title": "Subscribe, see it, cancel",
  "description": "A signed-in walk through subscription bundles: what Subscribe starts, where an active subscription shows, and how it ends.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "See the full sign-in and day pass walkthrough in our sign-in video.",
          "headline": "Sign in and day pass, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "fastForward": true,
      "steps": [{ "action": "click", "target": "a.login-link" }, { "action": "login" }, { "action": "consent" }]
    },
    {
      "id": "subscribe",
      "chapter": "Subscribe",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "A subscription bundle runs every month until you cancel it.",
          "headline": "Subscription bundles",
          "keyWord": "Subscription"
        },
        { "action": "await", "until": "#catalogBundles .service-item", "label": "Loading the bundle catalogue" },
        {
          "action": "scroll",
          "target": "button[data-bundle-id='resident-vat']",
          "caption": "Subscribe opens Stripe's own checkout, where a live site takes a card.",
          "headline": "Subscribe via Stripe",
          "keyWord": "Stripe"
        },
        { "action": "point", "target": "button[data-subscribe][data-bundle-id='resident-vat']", "dwellMs": 500 },
        { "action": "hold", "ms": 1200 }
      ]
    },
    {
      "id": "active",
      "chapter": "Once it's active",
      "still": true,
      "steps": [
        {
          "action": "ensureBundle",
          "bundle": "Resident VAT",
          "testPass": true,
          "caption": "Once active, it shows in your current bundles.",
          "headline": "See it as a current bundle",
          "keyWord": "current"
        },
        { "action": "await", "until": "#currentBundlesSection", "label": "Loading current bundles" },
        { "action": "scroll", "target": "#currentBundlesSection" },
        { "action": "point", "target": "#currentBundles", "dwellMs": 500 },
        { "action": "hold", "ms": 1200 },
        { "action": "still", "name": "subscription-active" }
      ]
    },
    {
      "id": "cancel",
      "chapter": "Cancel",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "A real subscription adds a Manage Subscription button.",
          "holdMs": 2500,
          "headline": "Cancel in Stripe's portal",
          "keyWord": "Cancel"
        },
        {
          "action": "caption",
          "text": "It opens Stripe's own billing portal — Cancel plan ends it.",
          "holdMs": 2500,
          "headline": "Cancel plan ends it",
          "keyWord": "Cancel"
        },
        { "action": "hold", "ms": 600 }
      ]
    }
  ]
}
