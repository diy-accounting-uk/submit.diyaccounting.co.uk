{
  "$schema": "./scene-script.schema.json",
  "name": "view-obligations",
  "title": "See what VAT you owe HMRC and when",
  "description": "A signed-in walk through VAT obligations: sign in, take out a day pass, ask HMRC for the periods on a VAT registration number, and read the answer.",
  "auth": "user",
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 1,
  "fps": 60,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "HMRC keeps a list of the VAT periods you owe."
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use."
        },
        {
          "action": "login",
          "caption": "Your account keeps your submissions in one place."
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run."
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true,
          "caption": "A day pass opens the VAT activities for a day."
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page."
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "obligations-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "button:has-text('VAT Obligations (HMRC)')",
          "caption": "Open VAT Obligations to ask HMRC what is due."
        },
        { "action": "await", "until": "#vatObligationsForm", "label": "Opening the obligations form" },
        {
          "action": "type",
          "target": "#vrn",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number."
        },
        {
          "action": "fill",
          "target": "#fromDate",
          "value": "{{monthsAgo:11}}",
          "caption": "Then the stretch of time to look at."
        },
        { "action": "fill", "target": "#toDate", "value": "{{today}}" },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access."
        },
        {
          "action": "hmrcAuthorise",
          "caption": "Sign in to HMRC and say yes once.",
          "timeoutMs": 60000
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "results",
      "chapter": "The answer",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#obligationsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers with the periods it is expecting."
        },
        { "action": "scroll", "target": "#obligationsTable" },
        { "action": "hold", "ms": 1500 },
        {
          "action": "point",
          "target": "#obligationsTable",
          "caption": "Each row is a period, its due date and its status.",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "obligations-table" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
