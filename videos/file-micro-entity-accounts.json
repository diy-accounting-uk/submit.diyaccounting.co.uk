{
  "$schema": "./scene-script.schema.json",
  "name": "file-micro-entity-accounts",
  "title": "File a company's micro-entity accounts with Companies House",
  "description": "A signed-in walk through filing micro-entity accounts: sign in, take out Resident Ltd, look up a company, fill in the balance sheet, preview the iXBRL, and file it with Companies House's sandbox.",
  "auth": "user",
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 1,
  "fps": 60,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "This is a sandbox preview against Companies House's test filing service, not a live filing."
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use."
        },
        {
          "action": "login",
          "caption": "Your account keeps your filings in one place."
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident Ltd",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run."
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident Ltd",
          "testPass": true,
          "caption": "Resident Ltd opens the micro-entity accounts filing."
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page."
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "company-lookup",
      "chapter": "Which company?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "File Micro-entity Accounts (Companies House)" },
          "expectsNavigation": true,
          "caption": "Open File Micro-entity Accounts to find the company."
        },
        { "action": "await", "until": "#companyForm", "label": "Opening the company lookup form" },
        {
          "action": "type",
          "target": "#companyNumber",
          "text": "06846849",
          "clear": true,
          "caption": "Type the company number."
        },
        {
          "action": "click",
          "target": "#companyLookupBtn",
          "caption": "Look up the company with Companies House."
        },
        { "action": "await", "until": "#formView", "label": "Looking up the company" },
        { "action": "point", "target": "#formCompanyName", "caption": "Companies House confirms the company name.", "dwellMs": 400 },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "accounts-form",
      "chapter": "The accounts",
      "still": true,
      "steps": [
        {
          "action": "fill",
          "target": "#periodStart",
          "value": "{{yearsAgo:1}}",
          "caption": "Set the accounting period."
        },
        { "action": "fill", "target": "#periodEnd", "value": "{{daysAgo:1}}" },
        {
          "action": "fill",
          "target": "#currentFixedAssets",
          "value": "1000",
          "caption": "Enter this year's balance sheet, then last year's for comparison."
        },
        { "action": "fill", "target": "#currentCurrentAssets", "value": "5000" },
        { "action": "fill", "target": "#currentCreditorsWithinOneYear", "value": "2000" },
        { "action": "fill", "target": "#currentCalledUpShareCapital", "value": "100" },
        { "action": "fill", "target": "#currentProfitAndLossAccount", "value": "3900" },
        { "action": "fill", "target": "#currentCapitalAndReserves", "value": "4000" },
        {
          "action": "point",
          "target": "#currentYearTotals",
          "caption": "This checks net assets against capital and reserves.",
          "dwellMs": 500
        },
        { "action": "fill", "target": "#priorFixedAssets", "value": "900" },
        { "action": "fill", "target": "#priorCurrentAssets", "value": "3500" },
        { "action": "fill", "target": "#priorCreditorsWithinOneYear", "value": "1500" },
        { "action": "fill", "target": "#priorCalledUpShareCapital", "value": "100" },
        { "action": "fill", "target": "#priorProfitAndLossAccount", "value": "1900" },
        { "action": "fill", "target": "#priorCapitalAndReserves", "value": "2900" },
        { "action": "fill", "target": "#averageEmployees", "value": "2" },
        {
          "action": "type",
          "target": "#directorName",
          "text": "Jo Director",
          "caption": "Name the director approving the accounts."
        },
        { "action": "fill", "target": "#directorDateApproved", "value": "{{today}}" },
        {
          "action": "click",
          "target": "#statementSection477Exemption",
          "caption": "Accept the four statutory statements."
        },
        { "action": "click", "target": "#statementMembersNotRequiredAudit" },
        { "action": "click", "target": "#statementDirectorsResponsibilities" },
        { "action": "click", "target": "#statementMicroEntityProvisions" },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "preview",
      "chapter": "Preview",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#previewBtn",
          "caption": "Preview the iXBRL before anything is filed."
        },
        { "action": "await", "until": "#previewView", "label": "Rendering the preview" },
        {
          "action": "point",
          "target": "#previewIxbrl",
          "caption": "This is the XML that will be filed. Nothing has gone to Companies House yet.",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 1000 }
      ]
    },
    {
      "id": "submit",
      "chapter": "File it",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#companyAuthCode",
          "text": "AB12CD",
          "clear": true,
          "secret": true,
          "caption": "Type the company's Companies House authentication code."
        },
        {
          "action": "click",
          "target": "#submitFilingBtn",
          "caption": "Submit the filing to Companies House's sandbox."
        },
        { "action": "await", "until": "#resultView", "label": "Submitting the filing" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "result",
      "chapter": "The outcome",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#filingResult:has-text('ACCEPT')",
          "label": "Waiting for Companies House",
          "timeoutMs": 60000,
          "caption": "Companies House settles on an outcome."
        },
        {
          "action": "point",
          "target": "#filingResult",
          "caption": "The filing is accepted.",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "file-micro-entity-accounts-result" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
