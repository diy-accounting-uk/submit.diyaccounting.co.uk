{
  "$schema": "./scene-script.schema.json",
  "name": "generate-pass-digital",
  "title": "Generate a digital pass to give away",
  "description": "A signed-in walk through generating a digital pass: a shareable link that gives whoever redeems it free VAT submission access for 7 days.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/passes/generate-digital.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "A digital pass gives someone else free VAT access for a week.",
          "headline": "Give away a digital pass",
          "keyWord": "pass"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": "a.login-link" },
        { "action": "login" },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident VAT",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": { "role": "link", "name": "Bundles" } },
        { "action": "ensureBundle", "bundle": "Resident VAT", "testPass": true },
        { "action": "hold", "ms": 700 },
        { "action": "click", "target": { "role": "link", "name": "Activities" } },
        {
          "action": "await",
          "until": "button:has-text('Generate Digital Pass')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "generate",
      "chapter": "Generate the pass",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "Generate Digital Pass" },
          "caption": "This spends a handful of tokens to mint a shareable pass.",
          "headline": "Open Generate Digital Pass",
          "keyWord": "Generate"
        },
        { "action": "await", "until": "#generatePassBtn:not([disabled])", "label": "Loading the token balance" },
        {
          "action": "type",
          "target": "#passNotes",
          "text": "Video demo",
          "caption": "A note for your own records, not shown to whoever redeems it.",
          "headline": "Add a note (optional)",
          "keyWord": "note"
        },
        {
          "action": "click",
          "target": "#generatePassBtn",
          "caption": "Companies House and HMRC never see who redeems it.",
          "headline": "Always redeemed anonymously",
          "keyWord": "anonymously"
        },
        { "action": "await", "until": "#passResult", "label": "Generating the pass" },
        {
          "action": "point",
          "target": "#generatedPassCode",
          "caption": "This is the pass code, ready to share.",
          "headline": "Share this code",
          "keyWord": "Share",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 1500 },
        { "action": "still", "name": "generate-pass-digital-result" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
