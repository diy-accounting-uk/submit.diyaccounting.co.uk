{
  "$schema": "./scene-script.schema.json",
  "name": "vat-from-books",
  "title": "Fill a VAT return from a book",
  "description": "A signed-in walk through a VAT return filled from a diya-gl book: drop the book on the form, check the nine boxes it fills, submit the return to HMRC's test service and see the receipt.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/hmrc/vat/submitVat.html"],
  "hmrcServices": ["mtd-vat", "mtd-income-tax"],
  "environments": ["ci"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 80,
    "betweenActionsMs": 500,
    "aroundMotionMs": 500,
    "minResidualMs": 120,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 16,
    "minMs": 1200,
    "fadeMs": 200,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 2500,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "This is a sandbox preview against HMRC's test service, not a live filing.",
          "headline": "A sandbox preview",
          "keyWord": "sandbox"
        },
        {
          "action": "point",
          "target": {
            "role": "heading",
            "name": "DIY Accounting Submit"
          },
          "dwellMs": 300
        },
        {
          "action": "hold",
          "ms": 400
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your submissions in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 400
        }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true,
          "caption": "A day pass opens the VAT activities for a day.",
          "headline": "Get a day pass",
          "keyWord": "pass"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "vat-form",
      "chapter": "Choose the period",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/vat/submitVat.html",
          "waitFor": "#vatSubmissionForm",
          "caption": "This is the form a VAT return is filed on.",
          "headline": "The VAT return form",
          "keyWord": "VAT"
        },
        {
          "action": "type",
          "target": "#vatNumber",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number.",
          "headline": "Enter your VAT number",
          "keyWord": "number"
        },
        {
          "action": "fill",
          "target": "#periodEnd",
          "value": "2025-09-30",
          "caption": "Choose the period the return covers.",
          "headline": "Choose the period",
          "keyWord": "period"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "import-book",
      "chapter": "Fill from a book",
      "still": true,
      "steps": [
        {
          "action": "dropFile",
          "target": "#booksImportDrop",
          "file": "videos/books/brickwork-pro-ltd-vat.json",
          "caption": "Drop your diya-gl book on the form.",
          "headline": "Drop your book",
          "keyWord": "book"
        },
        {
          "action": "await",
          "until": "#booksImportStatus:has-text('Filled the nine boxes')",
          "label": "Reading the book",
          "timeoutMs": 30000,
          "caption": "The nine boxes fill from the book's own figures.",
          "headline": "The boxes fill",
          "keyWord": "fill"
        },
        {
          "action": "scroll",
          "target": "#vatDueSales"
        },
        {
          "action": "hold",
          "ms": 600
        },
        {
          "action": "point",
          "target": "#vatDueSales",
          "dwellMs": 500,
          "caption": "Box 1 is the VAT due on the period's sales.",
          "headline": "Box 1 from the book",
          "keyWord": "sales"
        },
        {
          "action": "point",
          "target": "#vatReclaimedCurrPeriod",
          "dwellMs": 500,
          "caption": "Box 4 is the VAT reclaimed on purchases.",
          "headline": "Box 4 from the book",
          "keyWord": "reclaimed"
        },
        {
          "action": "point",
          "target": "#totalValueSalesExVAT",
          "dwellMs": 500,
          "caption": "Boxes 6 and 7 total sales and purchases.",
          "headline": "Boxes 6 and 7",
          "keyWord": "purchases"
        },
        {
          "action": "point",
          "target": "#totalValuePurchasesExVAT",
          "dwellMs": 500,
          "caption": "Check every figure before you submit.",
          "headline": "Check the figures",
          "keyWord": "Check"
        },
        {
          "action": "hold",
          "ms": 800
        },
        {
          "action": "still",
          "name": "vat-from-books-filled"
        },
        {
          "action": "click",
          "target": "#declaration",
          "caption": "Tick the declaration to confirm the return is accurate.",
          "headline": "Confirm the declaration",
          "keyWord": "declaration"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "submit",
      "chapter": "Submit to HMRC",
      "still": true,
      "steps": [
        {
          "action": "checkHidden",
          "target": "#allowSyntheticObligations"
        },
        {
          "action": "click",
          "target": "#submitBtn",
          "caption": "Submitting sends you to HMRC to grant access.",
          "headline": "Submit the return",
          "keyWord": "Submit"
        },
        {
          "action": "hmrcAuthorise",
          "timeoutMs": 60000,
          "caption": "Sign in to HMRC and say yes.",
          "headline": "Grant HMRC access",
          "keyWord": "HMRC"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "receipt",
      "chapter": "Submitted",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#receiptDisplay",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC confirms the return is filed.",
          "headline": "HMRC confirms it's filed",
          "keyWord": "filed"
        },
        {
          "action": "scroll",
          "target": "#receiptDisplay"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "point",
          "target": "#receiptDisplay",
          "dwellMs": 600,
          "caption": "The receipt is your record that it went through.",
          "headline": "Keep your receipt",
          "keyWord": "receipt"
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "still",
          "name": "vat-from-books-receipt"
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    }
  ]
}
