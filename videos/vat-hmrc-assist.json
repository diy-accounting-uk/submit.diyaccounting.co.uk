{
  "$schema": "./scene-script.schema.json",
  "name": "vat-hmrc-assist",
  "title": "Check a VAT return with HMRC Assist before you submit",
  "description": "A signed-in walk through HMRC Assist on the VAT return: fill in the nine boxes for an open period, ask HMRC Assist to check them, read its messages, then submit the return.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/hmrc/vat/submitVat.html"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "HMRC Assist checks a VAT return before you send it.",
          "headline": "Check your return first",
          "keyWord": "Check"
        },
        {
          "action": "caption",
          "text": "See the full sign-in and day pass walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in and day pass, faster",
          "keyWord": "faster"
        },
        {
          "action": "point",
          "target": {
            "role": "heading",
            "name": "DIY Accounting Submit"
          },
          "dwellMs": 300
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your submissions in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true,
          "caption": "A day pass opens the VAT activities for a day.",
          "headline": "Get a day pass",
          "keyWord": "pass"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        {
          "action": "await",
          "until": "button:has-text('Submit VAT (HMRC)')",
          "label": "Waiting for the day pass to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "vat-form",
      "chapter": "Open the VAT return",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "button:has-text('Submit VAT (HMRC)')",
          "caption": "Start a VAT return from the activities page.",
          "headline": "Start a VAT return",
          "keyWord": "Start"
        },
        {
          "action": "await",
          "until": "#vatSubmissionForm",
          "label": "Opening the submission form"
        },
        {
          "action": "type",
          "target": "#vatNumber",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number.",
          "headline": "Enter your VAT number",
          "keyWord": "number"
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "#connectHmrcBtn",
          "caption": "HMRC lists your open periods once you grant access.",
          "headline": "Ask HMRC for access",
          "keyWord": "access"
        },
        {
          "action": "hmrcAuthorise",
          "caption": "See the full HMRC access walkthrough in our HMRC authorisation video.",
          "headline": "Grant access, faster",
          "keyWord": "faster",
          "timeoutMs": 60000
        },
        {
          "action": "await",
          "until": "#obligationChoiceGroup",
          "label": "Waiting for the open periods",
          "timeoutMs": 60000
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "fill-boxes",
      "chapter": "Fill in the return",
      "still": true,
      "steps": [
        {
          "action": "point",
          "target": "#obligationChoice",
          "caption": "HMRC supplies the open period to file for.",
          "headline": "Choose the open period",
          "keyWord": "period",
          "dwellMs": 500
        },
        {
          "action": "type",
          "target": "#vatDueSales",
          "text": "1500.00",
          "clear": true,
          "caption": "Box 1 is the VAT due on your sales.",
          "headline": "Box 1, VAT on sales",
          "keyWord": "sales"
        },
        {
          "action": "type",
          "target": "#vatDueAcquisitions",
          "text": "0.00",
          "clear": true
        },
        {
          "action": "type",
          "target": "#vatReclaimedCurrPeriod",
          "text": "300.00",
          "clear": true,
          "caption": "Box 4 is the VAT you reclaim on purchases.",
          "headline": "Box 4, VAT reclaimed",
          "keyWord": "reclaimed"
        },
        {
          "action": "type",
          "target": "#totalValueSalesExVAT",
          "text": "7500",
          "clear": true,
          "caption": "Box 6 is your total sales, without VAT.",
          "headline": "Box 6, total sales",
          "keyWord": "sales"
        },
        {
          "action": "type",
          "target": "#totalValuePurchasesExVAT",
          "text": "1500",
          "clear": true,
          "caption": "Box 7 is your total purchases, without VAT.",
          "headline": "Box 7, total purchases",
          "keyWord": "purchases"
        },
        {
          "action": "type",
          "target": "#totalValueGoodsSuppliedExVAT",
          "text": "0",
          "clear": true
        },
        {
          "action": "type",
          "target": "#totalAcquisitionsExVAT",
          "text": "0",
          "clear": true
        },
        {
          "action": "click",
          "target": "#declaration",
          "caption": "Tick the declaration to confirm the return is accurate.",
          "headline": "Confirm the declaration",
          "keyWord": "declaration"
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "assist-check",
      "chapter": "Check with HMRC Assist",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#hmrcAssistCheckBtn",
          "caption": "Before you submit, ask HMRC Assist to check the return.",
          "headline": "Ask HMRC Assist",
          "keyWord": "Assist"
        },
        {
          "action": "await",
          "until": "#hmrcAssistMessages",
          "label": "Waiting for HMRC Assist",
          "timeoutMs": 60000
        },
        {
          "action": "scroll",
          "target": "#hmrcAssistMessages"
        },
        {
          "action": "hold",
          "ms": 1000
        },
        {
          "action": "point",
          "target": "#hmrcAssistMessages",
          "caption": "HMRC Assist answers with messages about the figures, in HMRC's own words.",
          "headline": "HMRC's messages",
          "keyWord": "messages",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 2500
        }
      ]
    },
    {
      "id": "submit",
      "chapter": "Submit the return",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#submitBtn",
          "caption": "The messages are advice. You decide whether to submit.",
          "headline": "You decide",
          "keyWord": "decide"
        }
      ]
    },
    {
      "id": "receipt",
      "chapter": "Submitted",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#receiptDisplay",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC confirms the return is filed.",
          "headline": "HMRC confirms it's filed",
          "keyWord": "filed"
        },
        {
          "action": "scroll",
          "target": "#receiptDisplay"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "point",
          "target": "#receiptDisplay",
          "caption": "The receipt is your record that it went through.",
          "headline": "Keep your receipt",
          "keyWord": "receipt",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "still",
          "name": "receipt"
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    }
  ],
  "consentAnswer": "declined"
}
