{
  "$schema": "./scene-script.schema.json",
  "name": "sign-in",
  "title": "Sign in and take out a day pass",
  "description": "A signed-in walk through the part every other activity starts with: sign in, then take out a day pass so activities unlock.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3500,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "Every activity needs an account signed in first.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "The Sign in link opens your identity provider.",
          "headline": "Click Sign in",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "This account signs in through Cognito's Hosted UI.",
          "headline": "Cognito hosts sign-in",
          "keyWord": "Cognito"
        },
        {
          "action": "caption",
          "text": "Google sign-in follows this same page. Its consent screen is Google's own.",
          "holdMs": 3500,
          "headline": "Google follows the same path",
          "keyWord": "Google"
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true,
          "caption": "A day pass opens the VAT activities for a day, no subscription needed.",
          "headline": "Get a day pass",
          "keyWord": "pass"
        },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "activities",
      "chapter": "Activities",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page, once you're signed in.",
          "headline": "Every activity starts here",
          "keyWord": "activities"
        },
        { "action": "scroll", "target": "#dynamicActivities" },
        { "action": "point", "target": "#dynamicActivities button:first-of-type", "dwellMs": 400 },
        { "action": "hold", "ms": 1200 }
      ]
    }
  ]
}
