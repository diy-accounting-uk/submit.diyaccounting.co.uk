{
  "$schema": "./scene-script.schema.json",
  "name": "company-lookup",
  "title": "Look up a company at Companies House",
  "description": "A signed-in walk through looking up a company: search by name or number, then read back its Companies House profile.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/companies-house/companySearch.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "Companies House holds the public record for every UK company.",
          "headline": "Look up a company",
          "keyWord": "company"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": "a.login-link", "caption": "Sign in with the account you already use." },
        { "action": "login", "caption": "Your account keeps your lookups in one place." },
        { "action": "consent" },
        {
          "action": "await",
          "until": "button:has-text('Company Lookup (Companies House)')",
          "label": "Waiting for the activity to appear"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "search",
      "chapter": "Search",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "Company Lookup (Companies House)" },
          "caption": "Open Company Lookup to search Companies House.",
          "headline": "Open Company Lookup",
          "keyWord": "Lookup"
        },
        { "action": "await", "until": "#companySearchForm", "label": "Opening the company search form" },
        {
          "action": "type",
          "target": "#companyQuery",
          "text": "06846849",
          "clear": true,
          "caption": "Type a company name or number.",
          "headline": "Search by name or number",
          "keyWord": "Search"
        },
        {
          "action": "click",
          "target": "#searchBtn",
          "caption": "Companies House answers with a profile."
        },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "profile",
      "chapter": "The profile",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#profileView, #searchResults",
          "label": "Waiting for Companies House",
          "timeoutMs": 30000,
          "caption": "The profile carries the company's status, address and officers.",
          "headline": "Read the company profile",
          "keyWord": "profile"
        },
        { "action": "hold", "ms": 1500 },
        { "action": "still", "name": "company-lookup-profile" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
