{
  "$schema": "./scene-script.schema.json",
  "name": "file-confirmation-statement",
  "title": "Start a company's confirmation statement",
  "description": "A signed-in walk through starting a confirmation statement: sign in, take out Resident Ltd, look up a company, and read its officers and PSCs from Companies House's register.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/companies-house/fileConfirmationStatement.html"
  ],
  "environments": ["ci"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "This is a sandbox preview against Companies House's test filing service, not a live filing.",
          "headline": "Confirmation statements",
          "keyWord": "statements"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": "a.login-link" },
        { "action": "login" },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident Ltd",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": { "role": "link", "name": "Bundles" } },
        { "action": "ensureBundle", "bundle": "Resident Ltd", "testPass": true },
        { "action": "hold", "ms": 700 },
        { "action": "click", "target": { "role": "link", "name": "Activities" } },
        {
          "action": "await",
          "until": "button:has-text('File Confirmation Statement (Companies House)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "company-lookup",
      "chapter": "Which company?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "File Confirmation Statement (Companies House)" },
          "expectsNavigation": true,
          "caption": "Open File Confirmation Statement to find the company.",
          "headline": "Open the activity",
          "keyWord": "statement"
        },
        { "action": "await", "until": "#companyForm", "label": "Opening the company lookup form" },
        {
          "action": "type",
          "target": "#companyNumber",
          "text": "06846849",
          "clear": true,
          "caption": "Type the company number.",
          "headline": "Enter the company number",
          "keyWord": "number"
        },
        {
          "action": "click",
          "target": "#companyLookupBtn",
          "caption": "Companies House confirms the next statement due.",
          "headline": "Confirm the next statement",
          "keyWord": "statement"
        },
        { "action": "await", "until": "#authView", "label": "Looking up the company" },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "register",
      "chapter": "The register",
      "still": true,
      "steps": [
        {
          "action": "point",
          "target": "#publicOfficersTable",
          "caption": "This is the company's own register of officers.",
          "headline": "The officers register",
          "keyWord": "officers",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 1200 },
        {
          "action": "point",
          "target": "#publicPscsTable",
          "caption": "And its people with significant control.",
          "headline": "People with significant control",
          "keyWord": "control",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 1200 },
        { "action": "still", "name": "file-confirmation-statement-register" },
        { "action": "hold", "ms": 1000 }
      ]
    }
  ]
}
