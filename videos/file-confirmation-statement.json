{
  "$schema": "./scene-script.schema.json",
  "name": "file-confirmation-statement",
  "title": "Start a company's confirmation statement",
  "description": "A signed-in walk through a confirmation statement from start to finish: sign in, take out Resident, look up a company, read its officers and PSCs from Companies House's register, review the statement, file it to the sandbox and open your copy of the filed record.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/companies-house/fileConfirmationStatement.html"
  ],
  "environments": ["ci"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#syntheticIndicator", "#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "A sandbox preview against Companies House's test filing service.",
          "headline": "Confirmation statements",
          "keyWord": "statements"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        {
          "action": "hold",
          "ms": 300
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link"
        },
        {
          "action": "login"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          }
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          }
        },
        {
          "action": "await",
          "until": "button:has-text('File Confirmation Statement (Companies House, sandbox)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "company-lookup",
      "chapter": "Which company?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "File Confirmation Statement (Companies House, sandbox)"
          },
          "expectsNavigation": true,
          "caption": "Open File Confirmation Statement to find the company.",
          "headline": "Open the activity",
          "keyWord": "statement"
        },
        {
          "action": "await",
          "until": "#companyForm",
          "label": "Opening the company lookup form"
        },
        {
          "action": "type",
          "target": "#companyNumber",
          "text": "06846849",
          "clear": true,
          "caption": "Type the company number.",
          "headline": "Enter the company number",
          "keyWord": "number"
        },
        {
          "action": "click",
          "target": "#companyLookupBtn",
          "caption": "Companies House confirms the next statement due.",
          "headline": "Confirm the next statement",
          "keyWord": "statement"
        },
        {
          "action": "await",
          "until": "#authView",
          "label": "Looking up the company"
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "register",
      "chapter": "The register",
      "still": true,
      "steps": [
        {
          "action": "point",
          "target": "#publicOfficersTable",
          "caption": "This is the company's own register of officers.",
          "headline": "The officers register",
          "keyWord": "officers",
          "dwellMs": 500
        },
        {
          "action": "hold",
          "ms": 1200
        },
        {
          "action": "point",
          "target": "#publicPscsTable",
          "caption": "And its people with significant control.",
          "headline": "People with significant control",
          "keyWord": "control",
          "dwellMs": 500
        },
        {
          "action": "hold",
          "ms": 1200
        },
        {
          "action": "still",
          "name": "file-confirmation-statement-register"
        },
        {
          "action": "hold",
          "ms": 1000
        }
      ]
    },
    {
      "id": "review",
      "chapter": "Review the statement",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#companyAuthCode",
          "text": "SIMCS01",
          "clear": true,
          "secret": true,
          "caption": "Type the company's authentication code.",
          "headline": "Enter the auth code",
          "keyWord": "code"
        },
        {
          "action": "click",
          "target": "#authSubmitBtn",
          "caption": "Companies House's register fills in the statement.",
          "headline": "Read the register data",
          "keyWord": "register"
        },
        {
          "action": "await",
          "until": "#reviewView",
          "label": "Reading the register data"
        },
        {
          "action": "point",
          "target": "#reviewDate",
          "scrollTo": "#reviewView h2",
          "caption": "The statement is filled in from the register. Change anything that is out of date.",
          "headline": "Review and change",
          "keyWord": "Review",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    },
    {
      "id": "directors",
      "chapter": "Confirm the directors",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#directorOtherForenames-0",
          "scrollTo": {
            "role": "heading",
            "name": "Director identity verification"
          },
          "text": "JANE",
          "clear": true,
          "caption": "Each director's other forenames and personal code are needed.",
          "headline": "Verify each director",
          "keyWord": "director"
        },
        {
          "action": "type",
          "target": "#directorPersonalCode-0",
          "text": "KJHLP471925",
          "clear": true,
          "secret": true
        },
        {
          "action": "type",
          "target": "#directorOtherForenames-1",
          "text": "OLIVER",
          "clear": true
        },
        {
          "action": "type",
          "target": "#directorPersonalCode-1",
          "text": "WMRTB508264",
          "clear": true,
          "secret": true
        },
        {
          "action": "click",
          "target": "#lawfulPurposeStatement",
          "scrollTo": {
            "role": "heading",
            "name": "Lawful purpose statement"
          },
          "caption": "Confirm the company's future activities are lawful.",
          "headline": "Confirm lawful purpose",
          "keyWord": "lawful"
        },
        {
          "action": "click",
          "target": "#stateConfirmation",
          "scrollTo": {
            "role": "heading",
            "name": "Lawful purpose statement"
          }
        },
        {
          "action": "hold",
          "ms": 1000
        }
      ]
    },
    {
      "id": "preview",
      "chapter": "Preview",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#previewBtn",
          "caption": "Preview the statement as it will be filed.",
          "headline": "Preview the filing",
          "keyWord": "Preview"
        },
        {
          "action": "await",
          "until": "#previewView",
          "label": "Rendering the preview"
        },
        {
          "action": "point",
          "target": "#previewSummary",
          "scrollTo": "#previewView h2",
          "caption": "Nothing has gone to Companies House yet.",
          "headline": "Nothing filed yet",
          "keyWord": "yet",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    },
    {
      "id": "result",
      "chapter": "The filing",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#submitFilingBtn"
        },
        {
          "action": "await",
          "until": "#filingRecord:has-text('Submission number')",
          "label": "Waiting for Companies House",
          "timeoutMs": 180000,
          "caption": "File the statement. Companies House checks it and reports the outcome.",
          "headline": "The filing outcome",
          "keyWord": "outcome"
        },
        {
          "action": "point",
          "target": "#filingResult",
          "dwellMs": 600
        },
        {
          "action": "point",
          "scrollTo": "#filingRecord",
          "caption": "Your copy shows the number, status, date and statement. It stays on your receipts.",
          "headline": "Your copy of the filing",
          "keyWord": "copy",
          "target": "#filingRecord h2.customer-copy-title",
          "dwellMs": 1500
        },
        {
          "action": "hold",
          "ms": 4000
        },
        {
          "action": "still",
          "name": "file-confirmation-statement-result"
        },
        {
          "action": "hold",
          "ms": 6000
        }
      ]
    }
  ]
}
