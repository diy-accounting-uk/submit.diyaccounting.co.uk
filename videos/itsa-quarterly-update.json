{
  "$schema": "./scene-script.schema.json",
  "name": "itsa-quarterly-update",
  "title": "From business details to a quarterly update with HMRC",
  "description": "A signed-in walk through Making Tax Digital for Income Tax: sign in, take out Resident, ask HMRC which businesses and quarterly obligations sit against a National Insurance number, then open the form a quarterly update is filed on.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/hmrc/itsa/dashboard.html",
    "web/public/hmrc/itsa/obligations.html",
    "web/public/hmrc/itsa/selfEmploymentPeriod.html"
  ],
  "hmrcServices": ["mtd-vat", "mtd-income-tax"],
  "environments": ["ci"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "This is a sandbox preview against HMRC's test service, not a live filing.",
          "headline": "A sandbox preview",
          "keyWord": "sandbox"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your filings in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true,
          "caption": "Resident opens the Self Assessment activities.",
          "headline": "Unlock Self Assessment",
          "keyWord": "Self"
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        {
          "action": "await",
          "until": "button:has-text('Self Assessment (HMRC)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "business-details",
      "chapter": "Which businesses?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "Self Assessment (HMRC)" },
          "expectsNavigation": true,
          "caption": "Making Tax Digital for Income Tax starts from one dashboard.",
          "headline": "One dashboard for MTD",
          "keyWord": "dashboard"
        },
        { "action": "await", "until": "#businessPickerForm", "label": "Opening the ITSA dashboard" },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "Type the National Insurance number HMRC asks for.",
          "headline": "Enter your NI number",
          "keyWord": "NI"
        },
        {
          "action": "click",
          "target": "#findBusinessesBtn",
          "caption": "Ask HMRC which businesses it holds against that number.",
          "headline": "Ask HMRC for businesses",
          "keyWord": "businesses"
        },
        {
          "action": "hmrcAuthorise",
          "caption": "See the full HMRC access walkthrough in our HMRC authorisation video.",
          "headline": "Grant access, faster",
          "keyWord": "faster",
          "timeoutMs": 60000,
          "fastForward": true
        },
        {
          "action": "await",
          "until": "#businessPickerResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC answers with every business behind this Self Assessment.",
          "headline": "HMRC lists your businesses",
          "keyWord": "businesses"
        },
        {
          "action": "point",
          "target": "#businessPickerList",
          "caption": "Each business carries an ID. Every later filing needs it.",
          "headline": "Note each business ID",
          "keyWord": "ID",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 1500 },
        { "action": "still", "name": "itsa-businesses" },
        { "action": "hold", "ms": 1000 }
      ]
    },
    {
      "id": "obligations",
      "chapter": "What's due?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Go to Obligations" },
          "caption": "Obligations groups the open and fulfilled quarters by business.",
          "headline": "See quarters by business",
          "keyWord": "quarters"
        },
        { "action": "await", "until": "#itsaObligationsForm", "label": "Opening the obligations form" },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "The same National Insurance number, every business.",
          "headline": "Same NI number",
          "keyWord": "NI"
        },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The read:self-assessment access from before still counts.",
          "headline": "Same access still counts",
          "keyWord": "access"
        },
        {
          "action": "await",
          "until": "#obligationsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC answers with each quarter's due date and status.",
          "headline": "Due dates and status",
          "keyWord": "status"
        },
        { "action": "scroll", "target": "#obligationsTable" },
        { "action": "hold", "ms": 1000 },
        {
          "action": "point",
          "target": "#obligationsTable",
          "caption": "Open means a quarterly update is still owed.",
          "headline": "Open means still owed",
          "keyWord": "Open",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2000 },
        { "action": "still", "name": "itsa-obligations" },
        { "action": "hold", "ms": 1000 }
      ]
    },
    {
      "id": "quarterly-update-form",
      "chapter": "File a quarterly update",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/dashboard.html",
          "waitFor": "#businessPickerForm",
          "caption": "Back to the dashboard to open the filing form.",
          "headline": "Back to the dashboard",
          "keyWord": "dashboard"
        },
        {
          "action": "click",
          "target": { "role": "link", "name": "Go to File a Quarterly Update" },
          "caption": "This is the form an open quarter is filed on.",
          "headline": "File the open quarter",
          "keyWord": "quarter"
        },
        { "action": "await", "until": "#itsaSelfEmploymentPeriodForm", "label": "Opening the quarterly update form" },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "The National Insurance number carries over.",
          "headline": "NI number carries over",
          "keyWord": "NI"
        },
        {
          "action": "point",
          "target": "#businessId",
          "caption": "The business ID from a moment ago goes here.",
          "headline": "Same business ID",
          "keyWord": "ID",
          "dwellMs": 600
        },
        {
          "action": "fill",
          "target": "#taxYear",
          "value": "2024-25",
          "caption": "Then the tax year this quarter falls in.",
          "headline": "Choose the tax year",
          "keyWord": "year"
        },
        { "action": "fill", "target": "#periodStartDate", "value": "2024-04-06" },
        { "action": "fill", "target": "#periodEndDate", "value": "2024-07-05" },
        {
          "action": "fill",
          "target": "#turnover",
          "value": "1000",
          "caption": "And the quarter's income and expenses.",
          "headline": "Income and expenses",
          "keyWord": "expenses"
        },
        { "action": "hold", "ms": 1500 },
        { "action": "still", "name": "itsa-quarterly-update-form" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
