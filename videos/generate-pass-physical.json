{
  "$schema": "./scene-script.schema.json",
  "name": "generate-pass-physical",
  "title": "Generate a physical pass to print",
  "description": "A signed-in walk through generating a physical pass: a code for merchandise or print that gives whoever redeems it free VAT submission access.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/passes/generate-physical.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "A physical pass is a code you can print or put on merchandise.",
          "headline": "Give away a physical pass",
          "keyWord": "pass"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": "a.login-link" },
        { "action": "login" },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident VAT",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": { "role": "link", "name": "Bundles" } },
        { "action": "ensureBundle", "bundle": "Resident VAT", "testPass": true },
        { "action": "hold", "ms": 700 },
        { "action": "click", "target": { "role": "link", "name": "Activities" } },
        {
          "action": "await",
          "until": "button:has-text('Generate Physical Pass')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "generate",
      "chapter": "Generate the pass",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "Generate Physical Pass" },
          "caption": "Unlike the digital pass, this one has no time limit, just a use limit.",
          "headline": "Open Generate Physical Pass",
          "keyWord": "Generate"
        },
        { "action": "await", "until": "#generatePassBtn:not([disabled])", "label": "Loading the token balance" },
        {
          "action": "click",
          "target": "#generatePassBtn",
          "caption": "It works the same way whether it ends up on a mug or a leaflet.",
          "headline": "Mint the code",
          "keyWord": "code"
        },
        { "action": "await", "until": "#passResult", "label": "Generating the pass" },
        {
          "action": "point",
          "target": "#generatedPassCode",
          "caption": "This is the code, ready to print or engrave.",
          "headline": "Ready to print",
          "keyWord": "print",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 1500 },
        { "action": "still", "name": "generate-pass-physical-result" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
