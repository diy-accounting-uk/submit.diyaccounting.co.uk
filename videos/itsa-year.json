{
  "$schema": "./scene-script.schema.json",
  "name": "itsa-year",
  "title": "A whole Income Tax year, quarter to declaration",
  "description": "A signed-in walk through Making Tax Digital for Income Tax across a full tax year: sign in, take out Resident, pick a business, file a quarterly update for a self-employment business and for a UK property business, then close the year out with the annual submission, its adjustable summary adjustments, losses and claims, the tax calculation and the final declaration.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/hmrc/itsa/dashboard.html",
    "web/public/hmrc/itsa/businessDetails.html",
    "web/public/hmrc/itsa/selfEmploymentPeriod.html",
    "web/public/hmrc/itsa/ukPropertyPeriod.html",
    "web/public/hmrc/itsa/annualSubmission.html",
    "web/public/hmrc/itsa/adjustments.html",
    "web/public/hmrc/itsa/lossesAndClaims.html",
    "web/public/hmrc/itsa/taxCalculation.html",
    "web/public/hmrc/itsa/finalDeclaration.html"
  ],
  "hmrcServices": ["mtd-vat", "mtd-income-tax"],
  "environments": ["ci"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 80,
    "betweenActionsMs": 500,
    "aroundMotionMs": 500,
    "minResidualMs": 120,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 16,
    "minMs": 1200,
    "fadeMs": 200,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 2500,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "This is a sandbox preview against HMRC's test service, not a live filing.",
          "headline": "A sandbox preview",
          "keyWord": "sandbox"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 400 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps a whole year's filings in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        { "action": "consent" },
        { "action": "hold", "ms": 400 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true,
          "caption": "Resident opens the Self Assessment activities.",
          "headline": "Unlock Self Assessment",
          "keyWord": "Self"
        },
        { "action": "hold", "ms": 500 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        { "action": "await", "until": ".developer-mode-toggle", "label": "Waiting for the developer mode toggle" },
        {
          "action": "click",
          "target": ".developer-mode-toggle",
          "caption": "One switch, so this run can ask HMRC's sandbox for two kinds of business.",
          "headline": "One switch, two businesses",
          "keyWord": "switch"
        },
        { "action": "hold", "ms": 400 }
      ]
    },
    {
      "id": "business-picker",
      "chapter": "The dashboard's business picker",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "Self Assessment (HMRC)" },
          "expectsNavigation": true,
          "caption": "Making Tax Digital for Income Tax starts from one dashboard.",
          "headline": "One dashboard for MTD",
          "keyWord": "dashboard"
        },
        { "action": "await", "until": "#businessPickerForm", "label": "Opening the ITSA dashboard" },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "Type the National Insurance number HMRC asks for.",
          "headline": "Enter your NI number",
          "keyWord": "NI"
        },
        {
          "action": "click",
          "target": "#findBusinessesBtn",
          "caption": "Ask HMRC which businesses it holds against that number.",
          "headline": "Ask HMRC for businesses",
          "keyWord": "businesses"
        },
        {
          "action": "hmrcAuthorise",
          "caption": "See the full HMRC access walkthrough in our HMRC authorisation video.",
          "headline": "Grant access, faster",
          "keyWord": "faster",
          "timeoutMs": 60000,
          "fastForward": true
        },
        {
          "action": "await",
          "until": "#businessPickerResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC answers with the businesses behind this Self Assessment.",
          "headline": "HMRC lists your businesses",
          "keyWord": "businesses"
        },
        {
          "action": "point",
          "target": "#businessPickerList",
          "caption": "Each business carries an ID.",
          "headline": "Note each business ID",
          "keyWord": "ID",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "business-details",
      "chapter": "Both businesses",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/dashboard.html",
          "waitFor": "#businessPickerForm",
          "caption": "This year has a self-employment and a UK property business.",
          "headline": "Two businesses this year",
          "keyWord": "Two"
        },
        {
          "action": "click",
          "target": { "role": "link", "name": "Go to Business Details" },
          "caption": "Business Details lists every business by type.",
          "headline": "List businesses by type",
          "keyWord": "type"
        },
        { "action": "await", "until": "#itsaBusinessDetailsForm", "label": "Opening the business details form" },
        {
          "action": "select",
          "target": "#testScenario",
          "value": "BUSINESS_AND_PROPERTY",
          "caption": "This sandbox account holds a self-employment and a property business.",
          "headline": "Self-employment and property",
          "keyWord": "property"
        },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "The same National Insurance number, every business.",
          "headline": "Same NI number",
          "keyWord": "NI"
        },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The scope granted a moment ago still covers this.",
          "headline": "Same scope covers this",
          "keyWord": "scope"
        },
        {
          "action": "await",
          "until": "#businessDetailsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC answers with both businesses and their IDs.",
          "headline": "Both businesses, two IDs",
          "keyWord": "IDs"
        },
        { "action": "scroll", "target": "#businessDetailsTable" },
        {
          "action": "point",
          "target": "#businessDetailsTable",
          "caption": "One quarterly update form per business type, all year.",
          "headline": "One form per business",
          "keyWord": "business",
          "dwellMs": 600
        },
        { "action": "still", "name": "itsa-year-businesses" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "quarterly-update-self-employment",
      "chapter": "Quarter: self-employment",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/selfEmploymentPeriod.html",
          "waitFor": "#itsaSelfEmploymentPeriodForm",
          "caption": "First quarter, the self-employment business.",
          "headline": "First quarter, self-employment",
          "keyWord": "self-employment"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        {
          "action": "fill",
          "target": "#businessId",
          "value": "XBIS00000000001",
          "caption": "This business's ID, from Business Details.",
          "headline": "The self-employment ID",
          "keyWord": "ID"
        },
        {
          "action": "fill",
          "target": "#taxYear",
          "value": "2026-27",
          "caption": "The tax year this quarter falls in.",
          "headline": "Choose the tax year",
          "keyWord": "year"
        },
        { "action": "fill", "target": "#periodStartDate", "value": "2026-04-06" },
        { "action": "fill", "target": "#periodEndDate", "value": "2026-07-05" },
        {
          "action": "fill",
          "target": "#turnover",
          "value": "1000",
          "caption": "Then the quarter's income and expenses.",
          "headline": "Income and expenses",
          "keyWord": "expenses"
        },
        { "action": "fill", "target": "#costOfGoods", "value": "150" },
        { "action": "hold", "ms": 500 },
        {
          "action": "click",
          "target": "#submitBtn",
          "caption": "File it with HMRC.",
          "headline": "File with HMRC",
          "keyWord": "File"
        },
        {
          "action": "await",
          "until": "#selfEmploymentPeriodResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the period summary.",
          "headline": "HMRC accepts the quarter",
          "keyWord": "accepts"
        },
        { "action": "still", "name": "itsa-year-self-employment-quarter" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "quarterly-update-uk-property",
      "chapter": "Quarter: UK property",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/ukPropertyPeriod.html",
          "waitFor": "#itsaUkPropertyPeriodForm",
          "caption": "Same quarter, the UK property business - its own form.",
          "headline": "Same quarter, property business",
          "keyWord": "property"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        {
          "action": "fill",
          "target": "#businessId",
          "value": "XPIS00000000002",
          "caption": "The property business's own ID.",
          "headline": "The property ID",
          "keyWord": "property"
        },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        { "action": "fill", "target": "#fromDate", "value": "2026-04-06" },
        { "action": "fill", "target": "#toDate", "value": "2026-07-05" },
        {
          "action": "fill",
          "target": "#periodAmount",
          "value": "800",
          "caption": "Rent received, and the expenses against it.",
          "headline": "Rent and expenses",
          "keyWord": "Rent"
        },
        { "action": "fill", "target": "#repairsAndMaintenance", "value": "100" },
        { "action": "hold", "ms": 500 },
        {
          "action": "click",
          "target": "#submitBtn",
          "caption": "File it with HMRC.",
          "headline": "File with HMRC",
          "keyWord": "File"
        },
        {
          "action": "await",
          "until": "#ukPropertyPeriodResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "Both businesses now have this quarter on file.",
          "headline": "Both businesses now filed",
          "keyWord": "filed"
        },
        { "action": "still", "name": "itsa-year-uk-property-quarter" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "annual-submission",
      "chapter": "Year end: annual submission",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/annualSubmission.html",
          "waitFor": "#itsaAnnualLoadForm",
          "caption": "Once every quarter is in, the year-end steps start here.",
          "headline": "Year-end steps start",
          "keyWord": "Year-end"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XBIS00000000001" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        {
          "action": "click",
          "target": "#loadBtn",
          "caption": "Load what HMRC already holds for the year.",
          "headline": "Load the year so far",
          "keyWord": "Load"
        },
        { "action": "await", "until": "#annualEditForm", "label": "Loading the annual submission" },
        {
          "action": "click",
          "target": "#allowanceTypeTrading",
          "caption": "Claim the trading income allowance instead of itemised ones.",
          "headline": "Claim the trading allowance",
          "keyWord": "allowance"
        },
        { "action": "fill", "target": "#tradingIncomeAllowance", "value": "1000" },
        {
          "action": "click",
          "target": "#saveBtn",
          "caption": "Save the year's allowances and adjustments.",
          "headline": "Save allowances and adjustments",
          "keyWord": "adjustments"
        },
        {
          "action": "await",
          "until": "#annualSubmissionResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the annual submission.",
          "headline": "HMRC accepts the year",
          "keyWord": "accepts"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "adjustments",
      "chapter": "Year end: adjustable summary",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/adjustments.html",
          "waitFor": "#itsaBsasTriggerForm",
          "caption": "HMRC works out a business source adjustable summary from the quarters filed.",
          "headline": "HMRC works out a summary",
          "keyWord": "summary"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XBIS00000000001" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        { "action": "fill", "target": "#accountingPeriodStartDate", "value": "2026-04-06" },
        { "action": "fill", "target": "#accountingPeriodEndDate", "value": "2027-04-05" },
        {
          "action": "click",
          "target": "#triggerBtn",
          "caption": "Trigger the summary and read what HMRC calculated.",
          "headline": "Trigger HMRC's summary",
          "keyWord": "summary"
        },
        {
          "action": "await",
          "until": "#summaryContainer",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "Turnover, expenses and the net profit HMRC worked out.",
          "headline": "Turnover, expenses, net profit",
          "keyWord": "profit"
        },
        { "action": "point", "target": "#summaryDetails", "dwellMs": 500 },
        {
          "action": "fill",
          "target": "#adjustTurnover",
          "value": "1100",
          "caption": "Change a figure if HMRC's version is wrong.",
          "headline": "Correct a figure",
          "keyWord": "Correct"
        },
        { "action": "fill", "target": "#adjustCostOfGoods", "value": "160" },
        { "action": "click", "target": "#submitAdjustmentBtn" },
        {
          "action": "await",
          "until": "#adjustmentResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the adjustment.",
          "headline": "HMRC accepts the change",
          "keyWord": "accepts"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "losses-and-claims",
      "chapter": "Year end: losses and claims",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/lossesAndClaims.html",
          "waitFor": "#itsaLossesLoadForm",
          "caption": "A loss this year, or from an earlier year, is claimed here.",
          "headline": "Claim a loss here",
          "keyWord": "loss"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XBIS00000000001" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        {
          "action": "click",
          "target": "#suspendTemporalValidations",
          "caption": "The sandbox's current tax year hasn't really ended, so suspend that check.",
          "headline": "Suspend the tax year check",
          "keyWord": "Suspend"
        },
        {
          "action": "click",
          "target": "#loadBtn",
          "caption": "Load this business's loss position for the year.",
          "headline": "Load the loss position",
          "keyWord": "loss"
        },
        { "action": "await", "until": "#lossesEditForm", "label": "Loading losses and claims" },
        {
          "action": "fill",
          "target": "#currentYearLosses",
          "value": "200",
          "caption": "This year's loss, carried forward to next year.",
          "headline": "Carry the loss forward",
          "keyWord": "loss"
        },
        { "action": "click", "target": "#saveBtn" },
        {
          "action": "await",
          "until": "#lossesResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the claim.",
          "headline": "HMRC accepts the claim",
          "keyWord": "claim"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "tax-calculation",
      "chapter": "Tax calculation",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/taxCalculation.html",
          "waitFor": "#itsaCalculationTriggerForm",
          "caption": "With every business and the year-end steps in, HMRC can calculate.",
          "headline": "HMRC can now calculate",
          "keyWord": "calculate"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        {
          "action": "select",
          "target": "#calculationType",
          "value": "intent-to-finalise",
          "caption": "Intent to finalise is the calculation the final declaration confirms.",
          "headline": "Intent to finalise",
          "keyWord": "finalise"
        },
        { "action": "testScenario", "value": "UK_SE_GIFTAID_EXAMPLE" },
        { "action": "click", "target": "#triggerBtn" },
        {
          "action": "await",
          "until": "#calculationResults",
          "label": "Calculating",
          "timeoutMs": 60000,
          "caption": "HMRC shows this disclaimer before any figure.",
          "headline": "HMRC's disclaimer first",
          "keyWord": "disclaimer"
        },
        {
          "action": "point",
          "target": "#calculationDisclaimer",
          "caption": "It is an estimate, and it can still change.",
          "headline": "Still an estimate",
          "keyWord": "estimate",
          "dwellMs": 700
        },
        {
          "action": "point",
          "target": "#totalIncomeTaxAndNicsDue",
          "caption": "What the whole tax year owes, across both businesses.",
          "headline": "What the year owes",
          "keyWord": "owes",
          "dwellMs": 700
        },
        { "action": "still", "name": "itsa-year-tax-calculation" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "final-declaration",
      "chapter": "Final declaration",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Continue to Final Declaration" },
          "caption": "The last step confirms this calculation and files the return.",
          "headline": "The final step",
          "keyWord": "final"
        },
        { "action": "await", "until": "#itsaFinalDeclarationRetrieveForm", "label": "Opening the final declaration form" },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "Retrieve the calculation this declaration confirms.",
          "headline": "Retrieve the calculation",
          "keyWord": "calculation"
        },
        {
          "action": "await",
          "until": "#declarationContainer",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "The same disclaimer, and every business HMRC counted.",
          "headline": "Same disclaimer, every business",
          "keyWord": "disclaimer"
        },
        { "action": "scroll", "target": "#businessesList" },
        { "action": "point", "target": "#businessesList", "dwellMs": 600 },
        {
          "action": "click",
          "target": "#declarationTick",
          "caption": "I confirm this information is correct and complete to the best of my knowledge.",
          "headline": "Confirm it's correct",
          "keyWord": "correct"
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": "#submitDeclarationBtn",
          "caption": "File the return for the whole year.",
          "headline": "File the whole year",
          "keyWord": "File"
        },
        {
          "action": "await",
          "until": "#finalDeclarationResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the final declaration. The year is filed.",
          "headline": "The year is filed",
          "keyWord": "filed"
        },
        { "action": "scroll", "target": "#finalDeclarationResults" },
        { "action": "hold", "ms": 600 },
        {
          "action": "point",
          "target": "#finalDeclarationResults h3",
          "caption": "Filed. The whole year is now closed out.",
          "headline": "Final declaration filed",
          "keyWord": "filed",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "itsa-year-final-declaration" },
        { "action": "hold", "ms": 1200 }
      ]
    }
  ]
}
