{
  "$schema": "./scene-script.schema.json",
  "name": "view-penalties",
  "title": "Check for VAT penalty points with HMRC",
  "description": "A signed-in walk through VAT penalties: sign in, take out a day pass, ask HMRC whether a VAT registration number carries any penalty points, and read the answer.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/hmrc/vat/vatPenalties.html"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ],
      "offCamera": true
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "steps": [
        {
          "action": "click",
          "target": "a.login-link"
        },
        {
          "action": "login"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ],
      "offCamera": true
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          }
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          }
        },
        {
          "action": "await",
          "until": "button:has-text('VAT Penalties (HMRC)')",
          "label": "Waiting for the day pass to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ],
      "offCamera": true
    },
    {
      "id": "penalties-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "HMRC can charge a penalty for a late VAT return or payment.",
          "holdMs": 1200,
          "headline": "Check for penalty points",
          "keyWord": "penalty"
        },
        {
          "action": "caption",
          "text": "You are already signed in. See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Already signed in",
          "keyWord": "signed"
        },
        {
          "action": "click",
          "target": "button:has-text('VAT Penalties (HMRC)')",
          "caption": "Open VAT Penalties to check for penalty points.",
          "headline": "Open VAT Penalties",
          "keyWord": "Penalties"
        },
        {
          "action": "await",
          "until": "#vatPenaltiesForm",
          "label": "Opening the penalties form"
        },
        {
          "action": "type",
          "target": "#vrn",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number. There is no date range to set.",
          "headline": "Enter your VAT number",
          "keyWord": "number"
        },
        {
          "action": "testScenario",
          "value": "MULTIPLE_PENALTIES"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access.",
          "headline": "Ask HMRC for access",
          "keyWord": "access"
        }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "offCamera": true,
      "steps": [
        {
          "action": "hmrcAuthorise",
          "timeoutMs": 60000
        }
      ]
    },
    {
      "id": "results",
      "chapter": "The answer",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "HMRC access was granted off screen. See it in full in our HMRC authorisation video.",
          "holdMs": 1200,
          "headline": "Access granted, faster",
          "keyWord": "faster"
        },
        {
          "action": "await",
          "until": "#penaltiesResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers for the last 24 months.",
          "headline": "HMRC sends the answer",
          "keyWord": "answer"
        },
        {
          "action": "scroll",
          "target": "#penaltiesResults"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "point",
          "target": "#penaltiesResults",
          "caption": "Any penalty points or charges show here.",
          "headline": "Read any penalty points",
          "keyWord": "penalty",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "still",
          "name": "penalties-results"
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    }
  ]
}
