{
  "$schema": "./scene-script.schema.json",
  "name": "itsa-uk-property-year",
  "title": "A UK property quarter, amended and closed out for the year",
  "description": "A signed-in walk through Making Tax Digital for Income Tax for a UK property business: see what's filed so far, open it, correct a figure, then close the year out with the annual submission and its adjustable summary.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/hmrc/itsa/ukPropertyPeriod.html",
    "web/public/hmrc/itsa/ukPropertyPeriods.html",
    "web/public/hmrc/itsa/ukPropertyPeriodView.html",
    "web/public/hmrc/itsa/ukPropertyPeriodAmend.html",
    "web/public/hmrc/itsa/ukPropertyAnnualSubmission.html",
    "web/public/hmrc/itsa/ukPropertyAdjustments.html"
  ],
  "hmrcServices": ["mtd-vat", "mtd-income-tax"],
  "environments": ["ci"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 80,
    "betweenActionsMs": 500,
    "aroundMotionMs": 500,
    "minResidualMs": 120,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 16,
    "minMs": 1200,
    "fadeMs": 200,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 2500,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "This is a sandbox preview against HMRC's test service, not a live filing.",
          "headline": "A sandbox preview",
          "keyWord": "sandbox"
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 400 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps a whole year's filings in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        { "action": "consent" },
        { "action": "hold", "ms": 400 }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true,
          "caption": "Resident opens the Self Assessment activities.",
          "headline": "Unlock Self Assessment",
          "keyWord": "Self"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "file-uk-property-quarter",
      "chapter": "File a quarter",
      "offCamera": true,
      "steps": [
        { "action": "goto", "url": "/hmrc/itsa/ukPropertyPeriod.html", "waitFor": "#itsaUkPropertyPeriodForm" },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XPIS00000000002" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        { "action": "fill", "target": "#fromDate", "value": "2026-04-06" },
        { "action": "fill", "target": "#toDate", "value": "2026-07-05" },
        { "action": "fill", "target": "#periodAmount", "value": "800" },
        { "action": "fill", "target": "#repairsAndMaintenance", "value": "100" },
        { "action": "click", "target": "#submitBtn" },
        { "action": "hmrcAuthorise", "timeoutMs": 60000 },
        { "action": "await", "until": "#ukPropertyPeriodResults", "label": "Filing the quarter", "timeoutMs": 60000 }
      ]
    },
    {
      "id": "list-quarters",
      "chapter": "What's filed so far",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/ukPropertyPeriods.html",
          "waitFor": "#itsaUkPropertyPeriodsForm",
          "caption": "Check what you've already told HMRC for this property.",
          "headline": "What's filed so far",
          "keyWord": "filed"
        },
        {
          "action": "type",
          "target": "#nino",
          "text": "{{hmrcNino}}",
          "clear": true,
          "secret": true,
          "caption": "Your National Insurance number.",
          "headline": "Your NI number",
          "keyWord": "NI"
        },
        {
          "action": "fill",
          "target": "#businessId",
          "value": "XPIS00000000002",
          "caption": "The property business's ID.",
          "headline": "The property ID",
          "keyWord": "property"
        },
        {
          "action": "fill",
          "target": "#taxYear",
          "value": "2026-27",
          "caption": "This tax year reports one running total, not a list of quarters.",
          "headline": "One running total",
          "keyWord": "total"
        },
        { "action": "hold", "ms": 400 },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "Ask HMRC for the current total.",
          "headline": "Ask HMRC for the total",
          "keyWord": "Ask"
        },
        {
          "action": "await",
          "until": "#periodsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC answers with the year-to-date total.",
          "headline": "The year-to-date total",
          "keyWord": "total"
        },
        { "action": "point", "target": "#periodsTable", "dwellMs": 500 },
        { "action": "still", "name": "uk-property-periods" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "view-quarter",
      "chapter": "Open it",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/ukPropertyPeriodView.html",
          "waitFor": "#itsaUkPropertyPeriodViewForm",
          "caption": "Open the total and see the figures behind it.",
          "headline": "Open the total",
          "keyWord": "Open"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XPIS00000000002" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        { "action": "hold", "ms": 400 },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "Retrieve it from HMRC.",
          "headline": "Retrieve it",
          "keyWord": "Retrieve"
        },
        {
          "action": "await",
          "until": "#periodViewResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "Rental income, other income and repairs, year to date.",
          "headline": "Rent and expenses",
          "keyWord": "Rent"
        },
        { "action": "point", "target": "#periodDetails", "dwellMs": 500 },
        { "action": "still", "name": "uk-property-period-view" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "amend-quarter",
      "chapter": "Correct it",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/ukPropertyPeriodAmend.html",
          "waitFor": "#itsaUkPropertyPeriodAmendForm",
          "caption": "Filed the wrong figure? Correct it here.",
          "headline": "Correct a filed figure",
          "keyWord": "Correct"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XPIS00000000002" },
        {
          "action": "fill",
          "target": "#taxYear",
          "value": "2026-27",
          "caption": "This tax year reports a running total, not one quarter.",
          "headline": "A running total",
          "keyWord": "running"
        },
        { "action": "hold", "ms": 400 },
        {
          "action": "click",
          "target": "#loadCurrentTotalBtn",
          "caption": "Load what HMRC holds before changing it.",
          "headline": "Load the current total",
          "keyWord": "Load"
        },
        {
          "action": "await",
          "until": "#statusMessagesContainer:has-text(\"Loaded the current\")",
          "label": "Loading the current total",
          "timeoutMs": 30000
        },
        {
          "action": "fill",
          "target": "#periodAmount",
          "value": "950",
          "caption": "Edit it to the corrected total for the year so far.",
          "headline": "Edit to the new total",
          "keyWord": "total"
        },
        { "action": "fill", "target": "#repairsAndMaintenance", "value": "120" },
        { "action": "hold", "ms": 500 },
        {
          "action": "click",
          "target": "#submitBtn",
          "caption": "Send the correction to HMRC.",
          "headline": "Send the correction",
          "keyWord": "correction"
        },
        {
          "action": "await",
          "until": "#periodAmendResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the amendment.",
          "headline": "HMRC accepts it",
          "keyWord": "accepts"
        },
        { "action": "still", "name": "uk-property-period-amend" },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "annual-submission",
      "chapter": "Year end: annual submission",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/ukPropertyAnnualSubmission.html",
          "waitFor": "#itsaAnnualLoadForm",
          "caption": "Once the year's quarters are in, the year-end steps start here.",
          "headline": "Year-end steps start",
          "keyWord": "Year-end"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XPIS00000000002" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        {
          "action": "click",
          "target": "#loadBtn",
          "caption": "Load what HMRC already holds for the year.",
          "headline": "Load the year so far",
          "keyWord": "Load"
        },
        { "action": "await", "until": "#annualEditForm", "label": "Loading the annual submission" },
        {
          "action": "click",
          "target": "#allowanceTypePropertyIncome",
          "caption": "Claim the property income allowance instead of itemised ones.",
          "headline": "Claim the property allowance",
          "keyWord": "allowance"
        },
        { "action": "fill", "target": "#propertyIncomeAllowance", "value": "1000" },
        { "action": "fill", "target": "#privateUseAdjustment", "value": "0" },
        {
          "action": "click",
          "target": "#saveBtn",
          "caption": "Save the year's allowances and adjustments.",
          "headline": "Save allowances and adjustments",
          "keyWord": "adjustments"
        },
        {
          "action": "await",
          "until": "#annualSubmissionResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the annual submission.",
          "headline": "HMRC accepts the year",
          "keyWord": "accepts"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "adjustments",
      "chapter": "Year end: adjustable summary",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/itsa/ukPropertyAdjustments.html",
          "waitFor": "#itsaBsasTriggerForm",
          "caption": "HMRC works out a business source adjustable summary from the quarters filed.",
          "headline": "HMRC works out a summary",
          "keyWord": "summary"
        },
        { "action": "type", "target": "#nino", "text": "{{hmrcNino}}", "clear": true, "secret": true },
        { "action": "fill", "target": "#businessId", "value": "XPIS00000000002" },
        { "action": "fill", "target": "#taxYear", "value": "2026-27" },
        { "action": "fill", "target": "#accountingPeriodStartDate", "value": "2026-04-06" },
        { "action": "fill", "target": "#accountingPeriodEndDate", "value": "2027-04-05" },
        {
          "action": "click",
          "target": "#triggerBtn",
          "caption": "Trigger the summary and read what HMRC calculated.",
          "headline": "Trigger HMRC's summary",
          "keyWord": "summary"
        },
        {
          "action": "await",
          "until": "#summaryContainer",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "Rental income, expenses and the net profit HMRC worked out.",
          "headline": "Rent, expenses, profit",
          "keyWord": "profit"
        },
        { "action": "point", "target": "#summaryDetails", "dwellMs": 500 },
        {
          "action": "fill",
          "target": "#adjustTotalRentsReceived",
          "value": "1000",
          "caption": "Change a figure if HMRC's version is wrong.",
          "headline": "Correct a figure",
          "keyWord": "Correct"
        },
        { "action": "click", "target": "#submitAdjustmentBtn" },
        {
          "action": "await",
          "until": "#adjustmentResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "HMRC accepts the adjustment.",
          "headline": "HMRC accepts the change",
          "keyWord": "accepts"
        },
        { "action": "scroll", "target": "#adjustmentResults" },
        { "action": "hold", "ms": 600 },
        {
          "action": "point",
          "target": "#adjustmentResults h3",
          "caption": "Submitted. HMRC has the corrected rental figure.",
          "headline": "Adjustment submitted",
          "keyWord": "submitted",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "uk-property-adjustments" },
        { "action": "hold", "ms": 1200 }
      ]
    }
  ]
}
