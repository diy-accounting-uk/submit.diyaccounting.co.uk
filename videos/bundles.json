{
  "$schema": "./scene-script.schema.json",
  "name": "bundles",
  "title": "View and edit your bundles",
  "description": "A signed-in walk through the bundles page: what you can add, typing a pass into the pass box, the pass page that shows what the pass gives, redeeming it, and removing a bundle you no longer want.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/pass.html"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#syntheticIndicator", "#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "See the full sign-in walkthrough in our sign-in video.",
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        {
          "action": "hold",
          "ms": 300
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link"
        },
        {
          "action": "login"
        },
        {
          "action": "consent"
        }
      ]
    },
    {
      "id": "open",
      "chapter": "Open Bundles",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "await",
          "until": "#catalogBundles .service-item",
          "label": "Loading the bundle catalogue"
        },
        {
          "action": "point",
          "target": "#catalogBundles",
          "caption": "Every bundle you can add is listed here.",
          "headline": "Bundles you can add",
          "keyWord": "add",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1200
        }
      ]
    },
    {
      "id": "make-pass",
      "chapter": "Make a pass",
      "offCamera": true,
      "steps": [
        {
          "action": "createPass",
          "bundle": "Day pass",
          "testPass": true
        }
      ]
    },
    {
      "id": "pass",
      "chapter": "Redeem a pass",
      "still": true,
      "steps": [
        {
          "action": "scroll",
          "target": "#passInput"
        },
        {
          "action": "type",
          "target": "#passInput",
          "text": "{{passCode}}",
          "secret": true,
          "caption": "A pass from someone else goes in this box.",
          "headline": "Enter your pass",
          "keyWord": "pass"
        },
        {
          "action": "click",
          "target": "#redeemPassBtn",
          "caption": "Redeem pass opens a page that shows what the pass gives you.",
          "headline": "The pass page opens",
          "keyWord": "opens"
        },
        {
          "action": "await",
          "until": "#passRedeemBtn",
          "label": "Checking the pass"
        },
        {
          "action": "point",
          "target": "#passCard",
          "caption": "The pass page shows the bundle, what it allows and when it ends.",
          "headline": "What the pass gives",
          "keyWord": "gives",
          "dwellMs": 600
        },
        {
          "action": "click",
          "target": "#passRedeemBtn",
          "caption": "Redeem pass adds the bundle to your account.",
          "headline": "Redeem the pass",
          "keyWord": "Redeem"
        },
        {
          "action": "await",
          "until": "#passHomeLink",
          "label": "Redeeming the pass"
        },
        {
          "action": "point",
          "target": "#passCard",
          "caption": "The page confirms that the pass is redeemed.",
          "headline": "Pass redeemed",
          "keyWord": "redeemed",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1000
        }
      ]
    },
    {
      "id": "add",
      "chapter": "Your current bundles",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#passBundlesLink",
          "caption": "See your bundles takes you back to the bundles page.",
          "headline": "Back to your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "await",
          "until": "#currentBundlesSection button[data-remove-bundle-id]",
          "label": "Loading current bundles"
        },
        {
          "action": "scroll",
          "target": "#currentBundlesSection"
        },
        {
          "action": "point",
          "target": "#currentBundles",
          "caption": "The bundle from the pass is now in your current bundles.",
          "headline": "Your current bundles",
          "keyWord": "current",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1200
        }
      ]
    },
    {
      "id": "remove",
      "chapter": "Remove a bundle",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#currentBundlesSection button[data-remove-bundle-id]",
          "caption": "Remove takes away a bundle you no longer want.",
          "headline": "Remove a bundle",
          "keyWord": "Remove"
        },
        {
          "action": "await",
          "until": "#statusMessagesContainer:has-text('removed successfully')",
          "label": "Removing the bundle"
        },
        {
          "action": "point",
          "target": "#statusMessagesContainer",
          "caption": "The page confirms the bundle is gone.",
          "headline": "The bundle is removed",
          "keyWord": "removed",
          "dwellMs": 600
        },
        {
          "action": "scroll",
          "target": "#catalogBundles"
        },
        {
          "action": "hold",
          "ms": 1200,
          "caption": "It is back in the list of bundles you can add.",
          "headline": "Back in the list",
          "keyWord": "list"
        },
        {
          "action": "still",
          "name": "bundles-result"
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    }
  ]
}
