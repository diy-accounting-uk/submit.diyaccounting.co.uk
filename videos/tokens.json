{
  "$schema": "./scene-script.schema.json",
  "name": "tokens",
  "title": "Tokens: what an activity costs and what's left",
  "description": "A signed-in walk through token balance: what a bundle grants, what each metered activity spends, and what happens when the balance runs out.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/usage.html",
    "web/public/widgets/auth-status.js"
  ],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "See the full sign-in and day pass walkthrough in our sign-in video.",
          "headline": "Sign in and day pass, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "fastForward": true,
      "steps": [{ "action": "click", "target": "a.login-link" }, { "action": "login" }, { "action": "consent" }]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "fastForward": true,
      "steps": [
        { "action": "click", "target": { "role": "link", "name": "Bundles" } },
        { "action": "ensureBundle", "bundle": "Day pass", "testPass": true },
        { "action": "hold", "ms": 200 }
      ]
    },
    {
      "id": "balance",
      "chapter": "Your balance",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": ".token-balance",
          "label": "Waiting for the token balance to load",
          "caption": "Every account carries a running token balance, shown in the header.",
          "headline": "Your balance, always on screen",
          "keyWord": "balance"
        },
        {
          "action": "click",
          "target": ".token-balance a",
          "expectsNavigation": true,
          "caption": "Click it to see where the tokens came from and where they went.",
          "headline": "Open token usage",
          "keyWord": "usage"
        },
        { "action": "await", "until": "#tokenSourcesBody tr", "label": "Loading token sources" },
        {
          "action": "point",
          "target": "#tokenSourcesTable",
          "caption": "Each bundle you hold grants tokens on its own schedule.",
          "headline": "What granted them",
          "keyWord": "granted",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 1000 },
        {
          "action": "scroll",
          "target": "#tokenConsumptionTable",
          "caption": "Every metered activity spends one token when it runs.",
          "headline": "What spent them",
          "keyWord": "spent"
        },
        { "action": "hold", "ms": 1200 },
        { "action": "still", "name": "tokens-usage" }
      ]
    },
    {
      "id": "running-out",
      "chapter": "Running out",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "Run out, and the activity says so before it lets you spend nothing.",
          "holdMs": 3500,
          "headline": "Running out is explained",
          "keyWord": "explained"
        },
        { "action": "hold", "ms": 600 }
      ]
    }
  ]
}
