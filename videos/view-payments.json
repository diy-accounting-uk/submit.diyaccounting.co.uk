{
  "$schema": "./scene-script.schema.json",
  "name": "view-payments",
  "title": "See VAT payments HMRC has recorded",
  "description": "A signed-in walk through VAT payments: sign in, take out a day pass, ask HMRC which payments it has recorded on a VAT registration number, and read the answer.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/hmrc/vat/vatPayments.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "HMRC keeps a record of the VAT payments it has received.",
          "headline": "See your VAT payments",
          "keyWord": "payments"
        },
        {
          "action": "caption",
          "text": "See the full sign-in and day pass walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in and day pass, faster",
          "keyWord": "faster"
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your submissions in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true,
          "caption": "A day pass opens the VAT activities for a day.",
          "headline": "Get a day pass",
          "keyWord": "pass"
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        {
          "action": "await",
          "until": "button:has-text('VAT Payments (HMRC)')",
          "label": "Waiting for the day pass to unlock the activity"
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "payments-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "button:has-text('VAT Payments (HMRC)')",
          "caption": "Open VAT Payments to ask what HMRC has recorded.",
          "headline": "Open VAT Payments",
          "keyWord": "Payments"
        },
        { "action": "await", "until": "#vatPaymentsForm", "label": "Opening the payments form" },
        {
          "action": "type",
          "target": "#vrn",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number.",
          "headline": "Enter your VAT number",
          "keyWord": "number"
        },
        {
          "action": "fill",
          "target": "#fromDate",
          "value": "2018-02-27",
          "caption": "Then the stretch of time to check.",
          "headline": "Choose the start date",
          "keyWord": "start"
        },
        { "action": "fill", "target": "#toDate", "value": "2018-12-21" },
        { "action": "testScenario", "value": "MULTIPLE_PAYMENTS_2018_19" },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access.",
          "headline": "Ask HMRC for access",
          "keyWord": "access"
        },
        {
          "action": "hmrcAuthorise",
          "caption": "See the full HMRC access walkthrough in our HMRC authorisation video.",
          "headline": "Grant access, faster",
          "keyWord": "faster",
          "timeoutMs": 60000
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "results",
      "chapter": "The answer",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#paymentsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers with whatever payments it has on file.",
          "headline": "HMRC sends the answer",
          "keyWord": "answer"
        },
        { "action": "scroll", "target": "#paymentsTable" },
        { "action": "hold", "ms": 1500 },
        {
          "action": "point",
          "target": "#paymentsTable",
          "caption": "Any payment against the account shows here, with its date.",
          "headline": "Read each payment",
          "keyWord": "payment",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "payments-table" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
