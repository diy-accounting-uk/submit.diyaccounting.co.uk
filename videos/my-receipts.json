{
  "$schema": "./scene-script.schema.json",
  "name": "my-receipts",
  "title": "Find a submission receipt again",
  "description": "A signed-in walk through submission receipts: submit a VAT return off camera, then find and open its receipt.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/hmrc/receipt/receipts.html"],
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 2,
  "fps": 30,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "Every submission leaves a receipt you can find again.",
          "headline": "Find a receipt again",
          "keyWord": "receipt"
        },
        {
          "action": "caption",
          "text": "See the full sign-in and day pass walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in and day pass, faster",
          "keyWord": "faster"
        },
        { "action": "hold", "ms": 300 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": "a.login-link" },
        { "action": "login" },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "fastForward": true,
      "steps": [
        { "action": "click", "target": { "role": "link", "name": "Bundles" } },
        { "action": "ensureBundle", "bundle": "Day pass", "testPass": true },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "submit-a-return",
      "chapter": "Submit a return",
      "offCamera": true,
      "steps": [{ "action": "submitReturn" }]
    },
    {
      "id": "receipts",
      "chapter": "Your receipts",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/receipt/receipts.html",
          "waitFor": "#receiptsTable",
          "caption": "Every past submission is listed here, newest first.",
          "headline": "See every receipt",
          "keyWord": "receipts"
        },
        {
          "action": "click",
          "target": ".receipt-label",
          "caption": "Open one to see the full HMRC response.",
          "headline": "Open a receipt",
          "keyWord": "Open"
        },
        { "action": "await", "until": "#receiptDisplay", "label": "Opening the receipt" },
        {
          "action": "point",
          "target": "#receiptContent",
          "caption": "It carries HMRC's own confirmation, kept for your records.",
          "headline": "HMRC's own confirmation",
          "keyWord": "confirmation",
          "dwellMs": 500
        },
        { "action": "hold", "ms": 1500 },
        { "action": "still", "name": "my-receipts-detail" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
