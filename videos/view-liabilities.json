{
  "$schema": "./scene-script.schema.json",
  "name": "view-liabilities",
  "title": "See what VAT you still owe HMRC",
  "description": "A signed-in walk through VAT liabilities: sign in, take out a day pass, ask HMRC what is outstanding on a VAT registration number, and read the answer.",
  "auth": "user",
  "pages": ["web/public/index.html", "web/public/auth/login.html", "web/public/bundles.html", "web/public/hmrc/vat/vatLiabilities.html"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ],
      "offCamera": true
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "steps": [
        {
          "action": "click",
          "target": "a.login-link"
        },
        {
          "action": "login"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ],
      "offCamera": true
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          }
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          }
        },
        {
          "action": "await",
          "until": "button:has-text('VAT Liabilities (HMRC)')",
          "label": "Waiting for the day pass to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ],
      "offCamera": true
    },
    {
      "id": "liabilities-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "HMRC keeps a running total of what you owe on VAT.",
          "holdMs": 1200,
          "headline": "See what you owe",
          "keyWord": "owe"
        },
        {
          "action": "caption",
          "text": "You are already signed in. See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Already signed in",
          "keyWord": "signed"
        },
        {
          "action": "click",
          "target": "button:has-text('VAT Liabilities (HMRC)')",
          "caption": "Open VAT Liabilities to ask what is outstanding.",
          "headline": "Open VAT Liabilities",
          "keyWord": "Liabilities"
        },
        {
          "action": "await",
          "until": "#vatLiabilitiesForm",
          "label": "Opening the liabilities form"
        },
        {
          "action": "type",
          "target": "#vrn",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number.",
          "headline": "Enter your VAT number",
          "keyWord": "number"
        },
        {
          "action": "fill",
          "target": "#fromDate",
          "value": "2018-04-05",
          "caption": "Then the stretch of time to check.",
          "headline": "Choose the start date",
          "keyWord": "start"
        },
        {
          "action": "fill",
          "target": "#toDate",
          "value": "2018-12-21"
        },
        {
          "action": "testScenario",
          "value": "MULTIPLE_LIABILITIES_2018_19"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access.",
          "headline": "Ask HMRC for access",
          "keyWord": "access"
        }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "offCamera": true,
      "steps": [
        {
          "action": "hmrcAuthorise",
          "timeoutMs": 60000
        }
      ]
    },
    {
      "id": "results",
      "chapter": "The answer",
      "still": true,
      "steps": [
        {
          "action": "caption",
          "text": "HMRC access was granted off screen. See it in full in our HMRC authorisation video.",
          "holdMs": 1200,
          "headline": "Access granted, faster",
          "keyWord": "faster"
        },
        {
          "action": "await",
          "until": "#liabilitiesResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers with whatever it currently has on file.",
          "headline": "HMRC sends the answer",
          "keyWord": "answer"
        },
        {
          "action": "scroll",
          "target": "#liabilitiesTable"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "point",
          "target": "#liabilitiesTable",
          "caption": "Any outstanding VAT shows here, with its due date.",
          "headline": "Read what you owe",
          "keyWord": "owe",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "still",
          "name": "liabilities-table"
        },
        {
          "action": "hold",
          "ms": 1500
        }
      ]
    }
  ]
}
