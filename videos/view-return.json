{
  "$schema": "./scene-script.schema.json",
  "name": "view-return",
  "title": "See a VAT return you already sent HMRC",
  "description": "A signed-in walk through viewing a submitted VAT return: sign in, take out a day pass, ask HMRC for the periods, authorise, then open a return HMRC has already received and read the nine boxes.",
  "auth": "user",
  "viewport": { "width": 1920, "height": 1080 },
  "deviceScaleFactor": 1,
  "fps": 60,

  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },

  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": { "topPct": 5, "bottomPct": 5, "sidePct": 12.5 }
  },

  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],

  "finalHoldMs": 3000,

  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "You can look up a VAT return you already sent HMRC."
        },
        { "action": "point", "target": { "role": "heading", "name": "DIY Accounting Submit" }, "dwellMs": 300 },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use."
        },
        {
          "action": "login",
          "caption": "Your account keeps your submissions in one place."
        },
        { "action": "consent" },
        { "action": "hold", "ms": 600 }
      ]
    },
    {
      "id": "day-pass",
      "chapter": "Day pass",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Bundles" },
          "caption": "Bundles decide which activities you can run."
        },
        {
          "action": "ensureBundle",
          "bundle": "Day pass",
          "testPass": true,
          "caption": "A day pass opens the VAT activities for a day."
        },
        { "action": "hold", "ms": 700 },
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Every activity starts from the home page."
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "obligations-form",
      "chapter": "Ask HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "button:has-text('VAT Obligations (HMRC)')",
          "caption": "First ask HMRC which periods it holds."
        },
        { "action": "await", "until": "#vatObligationsForm", "label": "Opening the obligations form" },
        {
          "action": "type",
          "target": "#vrn",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "Type the VAT registration number."
        },
        {
          "action": "fill",
          "target": "#fromDate",
          "value": "{{monthsAgo:11}}",
          "caption": "Then the stretch of time to look at."
        },
        { "action": "fill", "target": "#toDate", "value": "{{today}}" },
        { "action": "hold", "ms": 700 }
      ]
    },
    {
      "id": "authorise",
      "chapter": "Authorise with HMRC",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "The first request sends you to HMRC to grant access."
        },
        {
          "action": "hmrcAuthorise",
          "caption": "Sign in to HMRC and say yes once.",
          "timeoutMs": 60000
        },
        { "action": "hold", "ms": 500 }
      ]
    },
    {
      "id": "results",
      "chapter": "The periods on file",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#obligationsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 180000,
          "caption": "HMRC answers with every period it holds."
        },
        { "action": "scroll", "target": "#obligationsTable" },
        { "action": "hold", "ms": 1500 },
        {
          "action": "point",
          "target": "#obligationsTable",
          "caption": "One of these periods is still open, waiting for a return.",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "obligations-table" },
        { "action": "hold", "ms": 1500 }
      ]
    },
    {
      "id": "submit-open-return",
      "chapter": "Submit the open return",
      "offCamera": true,
      "steps": [{ "action": "submitReturn" }]
    },
    {
      "id": "obligations-again",
      "chapter": "Ask again",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "link", "name": "Activities" },
          "caption": "Back to the activities, to ask again."
        },
        { "action": "hold", "ms": 500 },
        {
          "action": "click",
          "target": "button:has-text('VAT Obligations (HMRC)')",
          "caption": "Ask HMRC the same question again."
        },
        { "action": "await", "until": "#vatObligationsForm", "label": "Opening the obligations form" },
        {
          "action": "type",
          "target": "#vrn",
          "text": "{{hmrcVatNumber}}",
          "clear": true,
          "caption": "The same VAT registration number."
        },
        { "action": "fill", "target": "#fromDate", "value": "{{monthsAgo:11}}" },
        { "action": "fill", "target": "#toDate", "value": "{{today}}" },
        { "action": "hold", "ms": 500 },
        {
          "action": "click",
          "target": "#retrieveBtn",
          "caption": "This time no HMRC sign-in is needed."
        },
        {
          "action": "await",
          "until": "#obligationsResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 60000,
          "caption": "The period just sent to HMRC now shows as fulfilled."
        },
        { "action": "scroll", "target": "#obligationsTable" },
        { "action": "hold", "ms": 1500 }
      ]
    },
    {
      "id": "view-return",
      "chapter": "The return",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": { "role": "button", "name": "View Return" },
          "caption": "Open the return HMRC just received."
        },
        {
          "action": "await",
          "until": "#returnResults",
          "label": "Waiting for HMRC",
          "timeoutMs": 450000,
          "caption": "HMRC sends back exactly what was filed."
        },
        { "action": "scroll", "target": "#returnDetails" },
        { "action": "hold", "ms": 1500 },
        {
          "action": "point",
          "target": "#returnDetails",
          "caption": "All nine boxes, just as they were submitted.",
          "dwellMs": 600
        },
        { "action": "hold", "ms": 2500 },
        { "action": "still", "name": "return-details" },
        { "action": "hold", "ms": 1500 }
      ]
    }
  ]
}
