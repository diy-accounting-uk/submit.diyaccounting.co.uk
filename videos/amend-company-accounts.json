{
  "$schema": "./scene-script.schema.json",
  "name": "amend-company-accounts",
  "title": "Revise accounts already filed with Companies House",
  "description": "A signed-in walk through revising micro-entity accounts Companies House has accepted: open the filing from your receipts, choose Amend, correct a figure, say what was wrong and what the revision changes, preview, file, and see the revised accounts accepted and listed on your receipts.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/hmrc/receipt/receipts.html",
    "web/public/companies-house/filings.html",
    "web/public/companies-house/fileMicroEntityAccounts.html"
  ],
  "environments": ["simulator"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#syntheticIndicator", "#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "Revise accounts Companies House has already accepted.",
          "headline": "Revise filed accounts",
          "keyWord": "Revise"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        {
          "action": "point",
          "target": "#dynamicActivities",
          "dwellMs": 300
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your filings in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident Ltd",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident Ltd",
          "testPass": true,
          "caption": "Resident Ltd opens the accounts filings.",
          "headline": "Unlock accounts filing",
          "keyWord": "accounts"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        {
          "action": "await",
          "until": "button:has-text('File Micro-entity Accounts (Companies House)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "original-filing",
      "chapter": "The original accounts",
      "offCamera": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "File Micro-entity Accounts (Companies House)"
          },
          "expectsNavigation": true
        },
        {
          "action": "await",
          "until": "#companyForm",
          "label": "Opening the company lookup form"
        },
        {
          "action": "type",
          "target": "#companyNumber",
          "text": "00000001",
          "clear": true
        },
        {
          "action": "click",
          "target": "#companyLookupBtn"
        },
        {
          "action": "await",
          "until": "#formView",
          "label": "Looking up the company"
        },
        {
          "action": "await",
          "until": "#priorYearNote:has-text('prior-year figures are filled in')",
          "label": "Filling last year's figures from the register"
        },
        {
          "action": "fill",
          "target": "#periodStart",
          "value": "{{yearsAgo:1}}"
        },
        {
          "action": "fill",
          "target": "#periodEnd",
          "value": "{{daysAgo:1}}"
        },
        {
          "action": "fill",
          "target": "#currentFixedAssets",
          "value": "1000"
        },
        {
          "action": "fill",
          "target": "#currentCurrentAssets",
          "value": "5000"
        },
        {
          "action": "fill",
          "target": "#currentCreditorsWithinOneYear",
          "value": "2000"
        },
        {
          "action": "fill",
          "target": "#currentCalledUpShareCapital",
          "value": "100"
        },
        {
          "action": "fill",
          "target": "#currentProfitAndLossAccount",
          "value": "3900"
        },
        {
          "action": "fill",
          "target": "#currentCapitalAndReserves",
          "value": "4000"
        },
        {
          "action": "fill",
          "target": "#priorFixedAssets",
          "value": "900"
        },
        {
          "action": "fill",
          "target": "#priorCurrentAssets",
          "value": "3500"
        },
        {
          "action": "fill",
          "target": "#priorCreditorsWithinOneYear",
          "value": "1500"
        },
        {
          "action": "fill",
          "target": "#priorCreditorsAfterOneYear",
          "value": "0"
        },
        {
          "action": "fill",
          "target": "#priorCalledUpShareCapital",
          "value": "100"
        },
        {
          "action": "fill",
          "target": "#priorProfitAndLossAccount",
          "value": "2800"
        },
        {
          "action": "fill",
          "target": "#priorCapitalAndReserves",
          "value": "2900"
        },
        {
          "action": "fill",
          "target": "#averageEmployees",
          "value": "2"
        },
        {
          "action": "type",
          "target": "#directorName",
          "text": "Joanna Hale"
        },
        {
          "action": "fill",
          "target": "#directorDateApproved",
          "value": "{{today}}"
        },
        {
          "action": "click",
          "target": "#statementSection477Exemption"
        },
        {
          "action": "click",
          "target": "#statementMembersNotRequiredAudit"
        },
        {
          "action": "click",
          "target": "#statementDirectorsResponsibilities"
        },
        {
          "action": "click",
          "target": "#statementMicroEntityProvisions"
        },
        {
          "action": "click",
          "target": "#previewBtn"
        },
        {
          "action": "await",
          "until": "#previewView",
          "label": "Rendering the preview"
        },
        {
          "action": "type",
          "target": "#companyAuthCode",
          "text": "AB12CD",
          "clear": true,
          "secret": true
        },
        {
          "action": "click",
          "target": "#submitFilingBtn"
        },
        {
          "action": "await",
          "until": "#filingResult:has-text('Companies House accepted the accounts')",
          "label": "Waiting for Companies House",
          "timeoutMs": 180000
        }
      ]
    },
    {
      "id": "receipts",
      "chapter": "Your receipts",
      "still": true,
      "steps": [
        {
          "action": "goto",
          "url": "/hmrc/receipt/receipts.html",
          "waitFor": "#receiptsTable .receipt-label",
          "scrollTo": "#receiptsTable",
          "caption": "Companies House accepted these accounts. Start from your receipts.",
          "instruction": "Open the Receipts page.",
          "headline": "Start from your receipts",
          "keyWord": "receipts"
        },
        {
          "action": "hold",
          "ms": 800
        },
        {
          "action": "click",
          "target": ".receipt-label >> nth=0",
          "expectsNavigation": true,
          "caption": "Open the accepted accounts filing.",
          "instruction": "Choose the receipt of the accounts filing you want to revise.",
          "headline": "Open the accepted filing",
          "keyWord": "accepted"
        },
        {
          "action": "await",
          "until": "#filingContent iframe.filed-document",
          "label": "Loading your copy"
        },
        {
          "action": "hold",
          "ms": 800
        }
      ]
    },
    {
      "id": "amend",
      "chapter": "Amend",
      "still": true,
      "steps": [
        {
          "action": "point",
          "target": "#amendFilingLink",
          "dwellMs": 500,
          "caption": "Choose Amend to revise these accounts.",
          "instruction": "Choose Amend on your copy of the filing.",
          "headline": "Choose Amend",
          "keyWord": "Amend"
        },
        {
          "action": "click",
          "target": "#amendFilingLink",
          "expectsNavigation": true
        },
        {
          "action": "await",
          "until": "#revisionSection",
          "label": "Reading the accounts you filed"
        },
        {
          "action": "point",
          "target": "#revisionBanner",
          "scrollTo": "#revisionBanner",
          "dwellMs": 600,
          "caption": "The form fills from the filing. The original stays on the register.",
          "instruction": "Check the banner: you are revising the accounts filed at Companies House, and the form holds the figures you filed.",
          "headline": "The original stays",
          "keyWord": "original"
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "correct-figure",
      "chapter": "Correct the figure",
      "still": true,
      "steps": [
        {
          "action": "fill",
          "target": "#averageEmployees",
          "value": "3",
          "scrollTo": {
            "role": "heading",
            "name": "Employees and director"
          },
          "caption": "Correct the figure. The company had 3 employees on average, not 2.",
          "instruction": "Change the figure that was wrong in the original accounts.",
          "headline": "Correct the figure",
          "keyWord": "Correct"
        },
        {
          "action": "hold",
          "ms": 800
        }
      ]
    },
    {
      "id": "revision-texts",
      "chapter": "The revision",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#revisionNonCompliance",
          "text": "The original accounts gave the average number of employees as 2; it was 3.",
          "clear": true,
          "scrollTo": {
            "role": "heading",
            "name": "The revision"
          },
          "caption": "Say what was wrong with the original accounts.",
          "instruction": "Under The revision, say what was wrong with the original accounts.",
          "headline": "What was wrong",
          "keyWord": "wrong"
        },
        {
          "action": "type",
          "target": "#revisionAmendments",
          "text": "The average number of employees is now 3. No other figure changes.",
          "clear": true,
          "caption": "Say what the revised accounts change.",
          "instruction": "Under What do the revised accounts change, describe the correction and anything that follows from it.",
          "headline": "What changes",
          "keyWord": "changes"
        },
        {
          "action": "fill",
          "target": "#directorDateApproved",
          "value": "{{today}}",
          "scrollTo": {
            "role": "heading",
            "name": "Employees and director"
          },
          "caption": "Date the approval. File within 28 days of it.",
          "instruction": "Enter the date the directors approved the revised accounts, and file them within 28 days of it.",
          "headline": "Within 28 days",
          "keyWord": "28"
        },
        {
          "action": "click",
          "target": "#statementSection477Exemption",
          "scrollTo": {
            "role": "heading",
            "name": "Statements"
          }
        },
        {
          "action": "click",
          "target": "#statementMembersNotRequiredAudit"
        },
        {
          "action": "click",
          "target": "#statementDirectorsResponsibilities"
        },
        {
          "action": "click",
          "target": "#statementMicroEntityProvisions",
          "caption": "Accept the four statements again.",
          "instruction": "Tick the four statements under Statements.",
          "headline": "Accept the statements",
          "keyWord": "statements"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "preview",
      "chapter": "Preview",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#previewBtn"
        },
        {
          "action": "await",
          "until": "#previewView",
          "label": "Rendering the preview"
        },
        {
          "action": "point",
          "target": "#previewRendered",
          "scrollTo": "#previewRendered",
          "dwellMs": 700,
          "caption": "The preview says what was wrong and what changes. Nothing is filed yet.",
          "instruction": "Choose Preview accounts, then read the revised accounts and the revision statement. Nothing is sent yet.",
          "headline": "Revised, not filed yet",
          "keyWord": "Revised"
        },
        {
          "action": "hold",
          "ms": 1000
        }
      ]
    },
    {
      "id": "submit",
      "chapter": "File it",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#companyAuthCode",
          "text": "AB12CD",
          "clear": true,
          "secret": true,
          "scrollTo": "#submissionCost",
          "caption": "Type the company's authentication code.",
          "instruction": "Enter the company's authentication code.",
          "headline": "Enter the auth code",
          "keyWord": "code"
        },
        {
          "action": "point",
          "target": "#submissionCost",
          "dwellMs": 600,
          "caption": "File the revised accounts with Companies House.",
          "instruction": "Check the cost, then choose Submit to Companies House.",
          "headline": "File the revision",
          "keyWord": "revision"
        },
        {
          "action": "click",
          "target": "#submitFilingBtn"
        },
        {
          "action": "await",
          "until": "#resultView",
          "label": "Submitting the filing"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "result",
      "chapter": "The outcome",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#filingResult:has-text('Companies House accepted the revised accounts.')",
          "label": "Waiting for Companies House",
          "timeoutMs": 180000,
          "caption": "Companies House accepted the revised accounts.",
          "instruction": "Wait while Companies House checks the revised accounts, then read the outcome.",
          "headline": "Revision accepted",
          "keyWord": "accepted"
        },
        {
          "action": "hold",
          "ms": 1200
        },
        {
          "action": "click",
          "target": "#filingCopyLink",
          "expectsNavigation": true,
          "caption": "Open your copy of the revised accounts.",
          "instruction": "Choose See your copy of this filing.",
          "headline": "Open your copy",
          "keyWord": "copy"
        },
        {
          "action": "await",
          "until": "#filingContent iframe.filed-document",
          "label": "Loading your copy"
        },
        {
          "action": "scroll",
          "scrollTo": {
            "role": "heading",
            "name": "Your copy of the revised accounts filed at Companies House"
          },
          "caption": "Your copy shows the revised accounts as filed.",
          "instruction": "Read your copy of the revised accounts.",
          "headline": "The revised accounts",
          "keyWord": "revised"
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "goto",
          "url": "/hmrc/receipt/receipts.html",
          "waitFor": ".receipt-kind",
          "scrollTo": "#receiptsTable",
          "caption": "Your receipts list it as revised accounts.",
          "instruction": "Find the filing on the Receipts page, listed as Revised accounts.",
          "headline": "Listed as revised",
          "keyWord": "revised"
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "still",
          "name": "amend-company-accounts-result"
        }
      ]
    }
  ]
}
