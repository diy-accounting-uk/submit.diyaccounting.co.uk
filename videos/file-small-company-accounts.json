{
  "$schema": "./scene-script.schema.json",
  "name": "file-small-company-accounts",
  "title": "File a company's small company accounts with Companies House",
  "description": "A signed-in walk through filing small company accounts: sign in, take out Resident, look up a company, fill in the profit and loss and balance sheet, preview the iXBRL, and file it with Companies House's sandbox. It ends on your copy of the filing.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/companies-house/fileSmallCompanyAccounts.html"
  ],
  "environments": ["ci"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "A sandbox preview against Companies House's test filing service.",
          "headline": "A sandbox preview",
          "keyWord": "sandbox"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        {
          "action": "point",
          "target": {
            "role": "heading",
            "name": "Activities"
          },
          "dwellMs": 300
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your filings in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true,
          "caption": "Resident opens the small company accounts filing.",
          "headline": "Unlock small company filing",
          "keyWord": "small"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        {
          "action": "await",
          "until": "button:has-text('File Small Company Accounts (Companies House, sandbox)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "company-lookup",
      "chapter": "Which company?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "File Small Company Accounts (Companies House, sandbox)"
          },
          "expectsNavigation": true,
          "caption": "Open File Small Company Accounts to find the company.",
          "headline": "Find the company",
          "keyWord": "company"
        },
        {
          "action": "await",
          "until": "#companyForm",
          "label": "Opening the company lookup form"
        },
        {
          "action": "type",
          "target": "#companyNumber",
          "text": "06846849",
          "clear": true,
          "caption": "Type the company number.",
          "headline": "Enter the company number",
          "keyWord": "number"
        },
        {
          "action": "click",
          "target": "#companyLookupBtn",
          "caption": "Look up the company with Companies House.",
          "headline": "Look up the company",
          "keyWord": "company"
        },
        {
          "action": "await",
          "until": "#formView",
          "label": "Looking up the company"
        },
        {
          "action": "point",
          "target": "#formCompanyName",
          "caption": "Companies House confirms the company name.",
          "headline": "Confirm the company name",
          "keyWord": "name",
          "dwellMs": 400
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "accounts-form",
      "chapter": "The accounts",
      "still": true,
      "steps": [
        {
          "action": "fill",
          "target": "#periodStart",
          "value": "{{yearsAgo:1}}",
          "caption": "Set the accounting period.",
          "headline": "Set the accounting period",
          "keyWord": "period"
        },
        {
          "action": "fill",
          "target": "#periodEnd",
          "value": "{{daysAgo:1}}"
        },
        {
          "action": "fill",
          "target": "#currentTurnover",
          "value": "20000",
          "caption": "Start with the profit and loss for this year.",
          "headline": "This year's profit and loss",
          "keyWord": "profit"
        },
        {
          "action": "fill",
          "target": "#currentCostOfSales",
          "value": "5000"
        },
        {
          "action": "fill",
          "target": "#currentAdministrativeExpenses",
          "value": "12000"
        },
        {
          "action": "fill",
          "target": "#currentInterestReceivable",
          "value": "0"
        },
        {
          "action": "fill",
          "target": "#currentTax",
          "value": "600"
        },
        {
          "action": "point",
          "target": "#currentProfitAndLossTotals",
          "caption": "The form works out gross profit, operating profit and profit for the year.",
          "headline": "Profit worked out",
          "keyWord": "Profit",
          "dwellMs": 500
        },
        {
          "action": "fill",
          "target": "#currentFixedAssets",
          "value": "1000",
          "caption": "Then the balance sheet: assets, then what the company owes.",
          "headline": "The balance sheet",
          "keyWord": "balance"
        },
        {
          "action": "fill",
          "target": "#currentStocks",
          "value": "500"
        },
        {
          "action": "fill",
          "target": "#currentDebtors",
          "value": "2500"
        },
        {
          "action": "fill",
          "target": "#currentCashAtBank",
          "value": "2000"
        },
        {
          "action": "fill",
          "target": "#currentTradeCreditors",
          "value": "1000"
        },
        {
          "action": "fill",
          "target": "#currentCorporationTax",
          "value": "700"
        },
        {
          "action": "fill",
          "target": "#currentOtherCreditors",
          "value": "300"
        },
        {
          "action": "fill",
          "target": "#currentCreditorsAfterOneYear",
          "value": "0"
        },
        {
          "action": "fill",
          "target": "#currentCalledUpShareCapital",
          "value": "100"
        },
        {
          "action": "fill",
          "target": "#currentProfitAndLossAccount",
          "value": "3900"
        },
        {
          "action": "point",
          "target": "#currentBalanceSheetTotals",
          "caption": "This checks net assets against capital and reserves.",
          "headline": "Net assets must balance",
          "keyWord": "balance",
          "dwellMs": 500
        },
        {
          "action": "click",
          "target": "#includeComparatives",
          "caption": "Add last year's figures for comparison.",
          "headline": "Add last year",
          "keyWord": "last"
        },
        {
          "action": "fill",
          "target": "#priorTurnover",
          "value": "18000"
        },
        {
          "action": "fill",
          "target": "#priorCostOfSales",
          "value": "4500"
        },
        {
          "action": "fill",
          "target": "#priorAdministrativeExpenses",
          "value": "11000"
        },
        {
          "action": "fill",
          "target": "#priorInterestReceivable",
          "value": "0"
        },
        {
          "action": "fill",
          "target": "#priorTax",
          "value": "400"
        },
        {
          "action": "fill",
          "target": "#priorFixedAssets",
          "value": "900"
        },
        {
          "action": "fill",
          "target": "#priorStocks",
          "value": "400"
        },
        {
          "action": "fill",
          "target": "#priorDebtors",
          "value": "2000"
        },
        {
          "action": "fill",
          "target": "#priorCashAtBank",
          "value": "1500"
        },
        {
          "action": "fill",
          "target": "#priorTradeCreditors",
          "value": "900"
        },
        {
          "action": "fill",
          "target": "#priorCorporationTax",
          "value": "500"
        },
        {
          "action": "fill",
          "target": "#priorOtherCreditors",
          "value": "200"
        },
        {
          "action": "fill",
          "target": "#priorCreditorsAfterOneYear",
          "value": "0"
        },
        {
          "action": "fill",
          "target": "#priorCalledUpShareCapital",
          "value": "100"
        },
        {
          "action": "fill",
          "target": "#priorProfitAndLossAccount",
          "value": "3100"
        },
        {
          "action": "type",
          "target": "#principalActivity",
          "text": "Software consultancy",
          "caption": "Say what the company does and how it states its figures.",
          "headline": "Describe the company",
          "keyWord": "company"
        },
        {
          "action": "type",
          "target": "#accountingPolicies",
          "text": "Historical cost convention."
        },
        {
          "action": "fill",
          "target": "#averageEmployees",
          "value": "4"
        },
        {
          "action": "type",
          "target": "#directors",
          "text": "Joanna Hale",
          "caption": "Name the directors.",
          "headline": "Name the directors",
          "keyWord": "directors"
        },
        {
          "action": "type",
          "target": "#directorName",
          "text": "Joanna Hale",
          "caption": "Name the director approving the accounts.",
          "headline": "Name the approving director",
          "keyWord": "approving"
        },
        {
          "action": "fill",
          "target": "#directorDateApproved",
          "value": "{{today}}"
        },
        {
          "action": "click",
          "target": "#statementSection477Exemption",
          "caption": "Accept the statutory statements.",
          "headline": "Accept the statements",
          "keyWord": "statements"
        },
        {
          "action": "click",
          "target": "#statementMembersNotRequiredAudit"
        },
        {
          "action": "click",
          "target": "#statementDirectorsResponsibilities"
        },
        {
          "action": "click",
          "target": "#statementSmallCompaniesRegime"
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "preview",
      "chapter": "Preview",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#previewBtn",
          "caption": "Preview the iXBRL before anything is filed.",
          "headline": "Preview the iXBRL",
          "keyWord": "iXBRL"
        },
        {
          "action": "await",
          "until": "#previewView",
          "label": "Rendering the preview"
        },
        {
          "scrollTo": "#previewRendered",
          "action": "point",
          "target": "#previewRendered",
          "caption": "These are the accounts as they will be filed. Nothing has gone to Companies House yet.",
          "headline": "Nothing filed yet",
          "keyWord": "yet",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1000
        }
      ]
    },
    {
      "id": "submit",
      "chapter": "File it",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#companyAuthCode",
          "text": "AB12CD",
          "clear": true,
          "secret": true,
          "caption": "Type the company's Companies House authentication code.",
          "headline": "Enter the auth code",
          "keyWord": "code"
        },
        {
          "action": "click",
          "target": "#submitFilingBtn",
          "caption": "Submit the filing to Companies House's sandbox.",
          "headline": "Submit to the sandbox",
          "keyWord": "sandbox"
        },
        {
          "action": "await",
          "until": "#resultView",
          "label": "Submitting the filing"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "result",
      "chapter": "The outcome",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#filingResult:has-text('ACCEPT')",
          "label": "Waiting for Companies House",
          "timeoutMs": 180000,
          "caption": "The filing goes to Companies House.",
          "headline": "Companies House checks it",
          "keyWord": "checks"
        },
        {
          "action": "point",
          "target": "#filingResult",
          "caption": "Companies House has the filing and reports the outcome here.",
          "headline": "Companies House has the filing",
          "keyWord": "filing",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "click",
          "target": "#filingCopyLink",
          "expectsNavigation": true,
          "caption": "Open your copy of the filing.",
          "headline": "Open your copy",
          "keyWord": "copy"
        },
        {
          "action": "await",
          "until": "#filingContent iframe.filed-document",
          "label": "Loading your copy"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "scroll",
          "to": "bottom",
          "caption": "Your copy shows the filed accounts, the submission number and the status.",
          "headline": "The filed accounts",
          "keyWord": "filed"
        },
        {
          "action": "hold",
          "ms": 4000
        },
        {
          "action": "still",
          "name": "file-small-company-accounts-result"
        },
        {
          "action": "hold",
          "ms": 2500,
          "caption": "Your copy stays on your receipts page.",
          "headline": "Kept on your receipts",
          "keyWord": "receipts"
        }
      ]
    }
  ]
}
