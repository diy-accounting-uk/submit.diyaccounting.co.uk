{
  "$schema": "./scene-script.schema.json",
  "name": "file-company-tax-return-typed",
  "title": "Type a Company Tax Return and let the checks catch a mistake",
  "description": "A signed-in walk through typing a Company Tax Return by hand: sign in, take out Resident, look up a company, type the figures, see the live check catch a wrong figure, correct it, preview the CT600 and file it with HMRC's test service.",
  "auth": "user",
  "pages": [
    "web/public/index.html",
    "web/public/auth/login.html",
    "web/public/bundles.html",
    "web/public/companies-house/fileCompanyTaxReturn.html"
  ],
  "environments": ["simulator"],
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 2,
  "fps": 30,
  "pacing": {
    "perCharMs": 90,
    "betweenActionsMs": 700,
    "aroundMotionMs": 600,
    "minResidualMs": 150,
    "timerThresholdMs": 250,
    "timerFullScaleMs": 5000,
    "waitCompressionAfterMs": 6000,
    "waitCompressionFactor": 8
  },
  "captions": {
    "fontPx": 40,
    "lineHeightPx": 56,
    "maxLines": 2,
    "maxCharsPerLine": 46,
    "charsPerSecond": 15,
    "minMs": 1500,
    "fadeMs": 250,
    "safeArea": {
      "topPct": 5,
      "bottomPct": 5,
      "sidePct": 12.5
    }
  },
  "suppress": ["#syntheticIndicator", "#feedbackEngagementBanner", "#feedbackEngagementSection"],
  "finalHoldMs": 3000,
  "scenes": [
    {
      "id": "home",
      "chapter": "Home",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "goto",
          "url": "/",
          "waitFor": "#mainContent",
          "caption": "A sandbox preview against HMRC's test service.",
          "headline": "A sandbox preview",
          "keyWord": "sandbox"
        },
        {
          "action": "caption",
          "text": "See the full sign-in walkthrough in our sign-in video.",
          "holdMs": 1200,
          "headline": "Sign in, faster",
          "keyWord": "faster"
        },
        {
          "action": "point",
          "target": {
            "role": "heading",
            "name": "Activities"
          },
          "dwellMs": 300
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "sign-in",
      "chapter": "Sign in",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": "a.login-link",
          "caption": "Sign in with the account you already use.",
          "headline": "Sign in first",
          "keyWord": "Sign"
        },
        {
          "action": "login",
          "caption": "Your account keeps your filings in one place.",
          "headline": "Confirm your identity",
          "keyWord": "identity"
        },
        {
          "action": "consent"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "subscription",
      "chapter": "Resident",
      "still": true,
      "fastForward": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Bundles"
          },
          "caption": "Bundles decide which activities you can run.",
          "headline": "Open your bundles",
          "keyWord": "bundles"
        },
        {
          "action": "ensureBundle",
          "bundle": "Resident",
          "testPass": true,
          "caption": "Resident opens the Company Tax Return filing.",
          "headline": "Unlock the tax return",
          "keyWord": "tax"
        },
        {
          "action": "hold",
          "ms": 700
        },
        {
          "action": "click",
          "target": {
            "role": "link",
            "name": "Activities"
          },
          "caption": "Every activity starts from the home page.",
          "headline": "Go to activities",
          "keyWord": "activities"
        },
        {
          "action": "await",
          "until": "button:has-text('File Company Tax Return (HMRC, preview)')",
          "label": "Waiting for the subscription to unlock the activity"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "company-lookup",
      "chapter": "Which company?",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": {
            "role": "button",
            "name": "File Company Tax Return (HMRC, preview)"
          },
          "expectsNavigation": true,
          "caption": "Open File Company Tax Return to find the company.",
          "headline": "Find the company",
          "keyWord": "company"
        },
        {
          "action": "await",
          "until": "#companyForm",
          "label": "Opening the company lookup form"
        },
        {
          "action": "type",
          "target": "#companyNumber",
          "text": "00000001",
          "clear": true,
          "caption": "Type the company number.",
          "headline": "Enter the company number",
          "keyWord": "number"
        },
        {
          "action": "click",
          "target": "#companyLookupBtn",
          "caption": "Look up the company with Companies House.",
          "headline": "Look up the company",
          "keyWord": "company"
        },
        {
          "action": "await",
          "until": "#formView",
          "label": "Looking up the company"
        },
        {
          "action": "point",
          "target": "#formCompanyName",
          "caption": "Companies House confirms the company name.",
          "headline": "Confirm the company name",
          "keyWord": "name",
          "dwellMs": 400
        },
        {
          "action": "hold",
          "ms": 700
        }
      ]
    },
    {
      "id": "period",
      "chapter": "The period",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#utr",
          "text": "8596148860",
          "clear": true,
          "caption": "Type the Unique Taxpayer Reference.",
          "headline": "Enter the UTR",
          "keyWord": "UTR"
        },
        {
          "action": "fill",
          "target": "#periodStart",
          "value": "2025-04-01"
        },
        {
          "action": "fill",
          "target": "#periodEnd",
          "scrollTo": { "role": "heading", "name": "Period" },
          "value": "2026-03-31",
          "caption": "Set the accounting period.",
          "headline": "Set the accounting period",
          "keyWord": "period"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "figures",
      "chapter": "The figures",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#currentTurnover",
          "scrollTo": { "role": "heading", "name": "Accounts" },
          "text": "100000",
          "clear": true,
          "caption": "Type this year's profit and loss, then the balance sheet.",
          "headline": "Type the figures",
          "keyWord": "figures"
        },
        {
          "action": "type",
          "target": "#currentCostOfSales",
          "text": "40000",
          "clear": true
        },
        {
          "action": "type",
          "target": "#currentAdministrativeExpenses",
          "text": "30000",
          "clear": true
        },
        {
          "action": "fill",
          "target": "#currentInterestReceivable",
          "value": "0"
        },
        {
          "action": "fill",
          "target": "#currentTax",
          "value": "0"
        },
        {
          "action": "type",
          "target": "#currentCashAtBank",
          "scrollTo": { "role": "heading", "name": "Balance sheet" },
          "text": "3010",
          "clear": true,
          "caption": "Here the cash figure has lost a digit.",
          "headline": "A figure with a typo",
          "keyWord": "typo"
        },
        {
          "action": "type",
          "target": "#currentCalledUpShareCapital",
          "text": "100",
          "clear": true
        },
        {
          "action": "type",
          "target": "#currentProfitAndLossAccount",
          "text": "30000",
          "clear": true
        },
        {
          "action": "click",
          "target": "#principalActivity"
        },
        {
          "action": "await",
          "until": "#currentProfitAndLossAccount-error",
          "label": "Checking the balance sheet"
        },
        {
          "action": "point",
          "target": "#currentProfitAndLossAccount-error",
          "scrollTo": { "role": "heading", "name": "Balance sheet" },
          "dwellMs": 900,
          "caption": "The check says the balance sheet does not balance.",
          "headline": "The check catches it",
          "keyWord": "catches"
        },
        {
          "action": "still",
          "name": "file-company-tax-return-typed-check"
        },
        {
          "action": "type",
          "target": "#currentCashAtBank",
          "scrollTo": { "role": "heading", "name": "Balance sheet" },
          "text": "30100",
          "clear": true,
          "caption": "Put the missing digit back and the message clears.",
          "headline": "Correct the figure",
          "keyWord": "Correct"
        },
        {
          "action": "click",
          "target": "#principalActivity"
        },
        {
          "action": "hold",
          "ms": 900
        }
      ]
    },
    {
      "id": "details",
      "chapter": "The details",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#principalActivity",
          "text": "Software consultancy",
          "clear": true
        },
        {
          "action": "fill",
          "target": "#accountingPolicies",
          "value": "The accounts are prepared under FRS 102 section 1A."
        },
        {
          "action": "fill",
          "target": "#directors",
          "value": "Carol Smith"
        },
        {
          "action": "fill",
          "target": "#averageEmployees",
          "value": "2"
        },
        {
          "action": "fill",
          "target": "#directorName",
          "value": "Carol Smith"
        },
        {
          "action": "fill",
          "target": "#directorDateApproved",
          "value": "2026-06-01"
        },
        {
          "action": "fill",
          "target": "#declarantName",
          "value": "Carol Smith"
        },
        {
          "action": "hold",
          "ms": 600
        },
        {
          "action": "click",
          "target": "#statementSection477Exemption",
          "caption": "Accept the four statutory statements.",
          "headline": "Accept the statements",
          "keyWord": "statements"
        },
        {
          "action": "click",
          "target": "#statementMembersNotRequiredAudit"
        },
        {
          "action": "click",
          "target": "#statementDirectorsResponsibilities"
        },
        {
          "action": "click",
          "target": "#statementSmallCompaniesRegime"
        },
        {
          "action": "click",
          "target": "#declarationAccepted",
          "scrollTo": { "role": "heading", "name": "Loans" },
          "caption": "Tick the declaration to confirm the return is accurate.",
          "headline": "Confirm the declaration",
          "keyWord": "declaration"
        },
        {
          "action": "hold",
          "ms": 600
        }
      ]
    },
    {
      "id": "preview",
      "chapter": "Review the return",
      "still": true,
      "steps": [
        {
          "action": "click",
          "target": "#previewBtn",
          "caption": "Preview the return before anything is sent.",
          "headline": "Preview the return",
          "keyWord": "Preview"
        },
        {
          "action": "await",
          "until": "#ct600Table tbody tr",
          "label": "Working out the CT600"
        },
        {
          "action": "scroll",
          "target": "#ct600Table"
        },
        {
          "action": "point",
          "target": "#ct600Table",
          "caption": "These are the CT600 boxes as HMRC will receive them.",
          "headline": "The CT600 boxes",
          "keyWord": "CT600",
          "dwellMs": 600
        },
        {
          "action": "scroll",
          "target": "#computationsTable"
        },
        {
          "action": "point",
          "target": "#computationsTable",
          "scrollTo": { "role": "heading", "name": "Computations" },
          "caption": "The tax computation sits beside the return.",
          "headline": "The tax computation",
          "keyWord": "computation",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 1000
        }
      ]
    },
    {
      "id": "submit",
      "chapter": "File it",
      "still": true,
      "steps": [
        {
          "action": "type",
          "target": "#gatewayUserId",
          "text": "dummy-gateway-user",
          "clear": true,
          "secret": true,
          "caption": "Type the company's Government Gateway user ID.",
          "headline": "Enter the Gateway user ID",
          "keyWord": "Gateway"
        },
        {
          "action": "type",
          "target": "#gatewayPassword",
          "text": "dummy-gateway-password",
          "clear": true,
          "secret": true,
          "caption": "Type the Government Gateway password.",
          "headline": "Enter the password",
          "keyWord": "password"
        },
        {
          "action": "click",
          "target": "#submitReturnBtn",
          "caption": "Submit the return to HMRC's test service.",
          "headline": "Submit to the test service",
          "keyWord": "test"
        },
        {
          "action": "await",
          "until": "#resultView",
          "label": "Submitting the return"
        },
        {
          "action": "hold",
          "ms": 500
        }
      ]
    },
    {
      "id": "result",
      "chapter": "The outcome",
      "still": true,
      "steps": [
        {
          "action": "await",
          "until": "#returnResult:has-text('ACCEPTED')",
          "label": "Waiting for HMRC",
          "timeoutMs": 120000,
          "caption": "The simulator accepts the return.",
          "headline": "The simulator accepts the return",
          "keyWord": "accepts"
        },
        {
          "action": "point",
          "target": "#returnIrmark",
          "caption": "The IRmark proves the return arrived unchanged.",
          "headline": "The IRmark",
          "keyWord": "IRmark",
          "dwellMs": 600
        },
        {
          "action": "hold",
          "ms": 2500
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "goto",
          "url": "/hmrc/receipt/receipts.html",
          "waitFor": "#receiptsTable .receipt-label",
          "caption": "Your receipts page lists the filing.",
          "headline": "Find your filing",
          "keyWord": "filing"
        },
        {
          "action": "click",
          "target": ".receipt-label",
          "expectsNavigation": true,
          "caption": "Open your copy of the filing.",
          "headline": "Open your copy",
          "keyWord": "copy"
        },
        {
          "action": "await",
          "until": "#filingContent iframe.filed-document",
          "label": "Loading your copy"
        },
        {
          "action": "hold",
          "ms": 1500
        },
        {
          "action": "scroll",
          "to": "top",
          "caption": "Your copy shows the return as filed, with its figures and declaration.",
          "headline": "The return as filed",
          "keyWord": "filed"
        },
        {
          "action": "hold",
          "ms": 4000
        },
        {
          "action": "scroll",
          "to": "bottom",
          "caption": "It ends with HMRC's receipt, the status and the date filed.",
          "headline": "HMRC's receipt",
          "keyWord": "receipt"
        },
        {
          "action": "hold",
          "ms": 4000
        },
        {
          "action": "still",
          "name": "file-company-tax-return-typed-result"
        },
        {
          "action": "hold",
          "ms": 2500,
          "caption": "Your copy stays on your receipts page.",
          "headline": "Kept on your receipts",
          "keyWord": "receipts"
        }
      ]
    }
  ]
}
