{
  "name": "@diy-accounting-uk/diya-submit",
  "version": "0.1.1",
  "description": "MCP server that opens a diya-gl book, derives filing figures and drives DIY Accounting Submit's HMRC and Companies House submissions",
  "type": "module",
  "license": "LicenseRef-PolyForm-Internal-Use-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diy-accounting-uk/submit.diyaccounting.co.uk.git",
    "directory": "mcp"
  },
  "bin": {
    "diya-submit-mcp": "bin/diya-submit-mcp.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./lib/server.js"
  },
  "config": {
    "workspaceDirName": "diy-accounting-limited"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node bin/diya-submit-mcp.js",
    "test:system": "vitest run --config vitest.system.config.js"
  },
  "dependencies": {
    "@diy-accounting-uk/diya-gl": "1.2.49",
    "@modelcontextprotocol/sdk": "1.31.0",
    "happy-dom": "20.9.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "overrides": {
    "smol-toml": "^1.9.0",
    "source-map-js": "^1.2.2"
  }
}
