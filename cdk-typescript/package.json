{
  "name": "cdk-typescript-spike",
  "version": "0.0.0",
  "private": true,
  "description": "Backlog 33a spike: one leaf CDK stack (CrossAccountBackupVaultStack) rewritten in TypeScript, for a template diff against the Java synth.",
  "scripts": {
    "build": "tsc",
    "synth": "cdk synth --app \"npx ts-node --transpile-only bin/cross-account-backup-vault.ts\" --output cdk.out",
    "diff": "node scripts/diff-templates.js"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "aws-cdk": "2.1138.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.266.0",
    "constructs": "10.8.1"
  }
}
