{
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(chmod:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run linting:*)",
      "Bash(npm run formatting:*)",
      "Bash(./mvnw:*)",
      "WebFetch(domain:developer.service.hmrc.gov.uk)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git branch -D claude/:*)",
      "Bash(git branch -D worktree-:*)",
      "Bash(git push origin --delete claude/:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git rebase -i:*)",
      "Bash(git branch -D main:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main-push.sh",
            "if": "Bash(git *)",
            "timeout": 15,
            "statusMessage": "Checking push target"
          }
        ]
      }
    ]
  }
}
