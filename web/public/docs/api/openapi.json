          }
        }, {
          "name" : "runFraudPreventionHeaderValidation",
          "in" : "query",
          "required" : false,
          "description" : "When true, validates HMRC Fraud Prevention Headers",
          "schema" : {
            "type" : "string"
          }
        } ],
        "tags" : [ "HMRC" ],
        "security" : [ {
          "CognitoAuth" : [ ]
        } ],
        "responses" : {
          "200" : {
            "description" : "Request completed successfully"
          }
